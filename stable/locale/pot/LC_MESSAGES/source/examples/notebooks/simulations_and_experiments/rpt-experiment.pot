#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:73
msgid "Load a simple degradation model"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:-1
msgid ""
"model = pybamm.lithium_ion.SPM({\"SEI\": \"ec reaction limited\"})\n"
"parameter_values = pybamm.ParameterValues(\"Mohtat2020\")\n"
"parameter_values.update({\"SEI kinetic rate constant [m.s-1]\": 1e-14})"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:96
msgid "Define three different experiments using the Experiment class:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:98
msgid "cccv_experiment is a cycle ageing experiment"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:99
msgid "charge_experiment charges to full after N ageing cycles"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:100
msgid ""
"rpt_experiment is a C/3 discharge in this case, but can also contain a "
"charge, GITT, EIS and other procedures"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:-1
msgid ""
"N = 10\n"
"cccv_experiment = pybamm.Experiment(\n"
"    [\n"
"        (\n"
"            \"Charge at 1C until 4.2V\",\n"
"            \"Hold at 4.2V until C/50\",\n"
"            \"Discharge at 1C until 3V\",\n"
"            \"Rest for 1 hour\",\n"
"        )\n"
"    ]\n"
"    * N\n"
")\n"
"charge_experiment = pybamm.Experiment(\n"
"    [\n"
"        (\n"
"            \"Charge at 1C until 4.2V\",\n"
"            \"Hold at 4.2V until C/50\",\n"
"        )\n"
"    ]\n"
")\n"
"rpt_experiment = pybamm.Experiment([(\"Discharge at C/3 until 3V\",)])"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:141
msgid ""
"Run the ageing, charge and RPT experiments in order by feeding the previous "
"solution into the solve command:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/rpt-experiment.ipynb:-1
msgid ""
"sim = pybamm.Simulation(\n"
"    model, experiment=cccv_experiment, parameter_values=parameter_values\n"
")\n"
"cccv_sol = sim.solve()\n"
"sim = pybamm.Simulation(\n"
"    model, experiment=charge_experiment, parameter_values=parameter_values\n"
")\n"
"charge_sol = sim.solve(starting_solution=cccv_sol)\n"
"sim = pybamm.Simulation(\n"
"    model, experiment=rpt_experiment, parameter_values=parameter_values\n"
")\n"
"rpt_sol = sim.solve(starting_solution=charge_sol)"
msgstr ""

