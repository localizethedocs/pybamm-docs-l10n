msgid "Customizing QuickPlot"
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:20
msgid ""
"This notebook shows how to customize PyBaMM's ``QuickPlot``, using "
"matplotlib's `style sheets and rcParams <https://matplotlib.org/stable/"
"tutorials/introductory/customizing.html>`__"
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:31
msgid "First we define and solve the models"
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import pybamm\n"
"\n"
"models = [pybamm.lithium_ion.SPM(), pybamm.lithium_ion.SPMe(), pybamm."
"lithium_ion.DFN()]\n"
"sims = []\n"
"for model in models:\n"
"    sim = pybamm.Simulation(model)\n"
"    sim.solve([0, 3600])\n"
"    sims.append(sim)"
msgstr ""

