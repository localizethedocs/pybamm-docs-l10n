#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:533
msgid ""
"We can also further control the plot by calling ``plot.fig`` after the "
"figure has been created, and editing the matplotlib objects. For example, "
"here we move the titles to the ylabel, and move the legend."
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:-1
msgid "[13]:"
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:-1
msgid ""
"pybamm.settings.max_words_in_line = 4\n"
"\n"
"plot = pybamm.QuickPlot(sims, figsize=(14, 7))\n"
"plot.plot(0.5)  # time in hours\n"
"\n"
"# Move title to ylabel\n"
"for ax in plot.fig.axes:\n"
"    title = ax.get_title()\n"
"    ax.set_title(\"\")\n"
"    ax.set_ylabel(title)\n"
"\n"
"# Remove old legend and add a new one in the bottom\n"
"leg = plot.fig.get_children()[-1]\n"
"leg.set_visible(False)\n"
"plot.fig.legend(plot.labels, loc=\"lower center\", ncol=len(plot.labels), "
"fontsize=11)\n"
"\n"
"# Adjust layout\n"
"plot.gridspec.tight_layout(plot.fig, rect=[0, 0.04, 1, 1])"
msgstr ""

#: ../../../source/examples/notebooks/plotting/customize-quick-plot.ipynb:579
msgid "The figure can then be saved using ``plot.fig.savefig``"
msgstr ""

