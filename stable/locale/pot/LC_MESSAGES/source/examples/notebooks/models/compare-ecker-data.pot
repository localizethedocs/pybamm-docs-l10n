#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:9
msgid "Comparing with Experimental Data"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:11
msgid ""
"In this notebook we show how to compare results generated in PyBaMM with "
"experimental data. We compare the results of the DFN model (see the `DFN "
"notebook <DFN.ipynb>`__) with the experimental data from Ecker et. al. `[5] "
"<#References>`__. Results are compared for a constant current discharge at "
"1C and at 5C."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:22
msgid ""
"First we import pybamm and any other packages required by this example, and "
"then change our working directory to the root of the pybamm folder."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import os\n"
"\n"
"import matplotlib.pyplot as plt\n"
"import pandas as pd\n"
"\n"
"import pybamm\n"
"\n"
"os.chdir(pybamm.__path__[0] + \"/..\")"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:51
msgid ""
"<pre>\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:57
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:64
msgid "Note: you may need to restart the kernel to use updated packages."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:75
msgid "We then load the Ecker data in from the ``.csv`` files using ``pandas``"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[9]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"data_loader = pybamm.DataLoader()\n"
"\n"
"voltage_data_1C = pd.read_csv(\n"
"    f\"{data_loader.get_data('Ecker_1C.csv')}\", header=None\n"
").to_numpy()\n"
"voltage_data_5C = pd.read_csv(\n"
"    f\"{data_loader.get_data('Ecker_5C.csv')}\", header=None\n"
").to_numpy()"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:103
msgid "Note that the data is Time [s] vs Voltage [V]."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:114
msgid ""
"We load the DFN model and select the parameter set from the Ecker paper [1]. "
"We update the C-rate an ``InputParameter`` so that we can re-run the same "
"model at different C-rates without the need to rebuild the model. This is "
"done by passing the flag ``[input]``."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[10]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"# choose DFN\n"
"model = pybamm.lithium_ion.DFN()\n"
"\n"
"# pick parameters, keeping C-rate as an input to be changed for each solve\n"
"parameter_values = pybamm.ParameterValues(\"Ecker2015\")\n"
"parameter_values.update({\"Current function [A]\": \"[input]\"})"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:140
msgid ""
"For this comparison we choose a fine mesh of 1 finite volume per micron in "
"the electrodes and separator and 1 finite volume per 0.1 micron in the "
"particles"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[11]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"var = pybamm.standard_spatial_vars\n"
"var_pts = {\n"
"    var.x_n: int(parameter_values.evaluate(model.param.n.L / 1e-6)),\n"
"    var.x_s: int(parameter_values.evaluate(model.param.s.L / 1e-6)),\n"
"    var.x_p: int(parameter_values.evaluate(model.param.p.L / 1e-6)),\n"
"    var.r_n: int(parameter_values.evaluate(model.param.n.prim.R_typ / "
"1e-7)),\n"
"    var.r_p: int(parameter_values.evaluate(model.param.p.prim.R_typ / "
"1e-7)),\n"
"}"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:168
msgid ""
"We create a simulation using our model, parameters and number of grid points"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[12]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"sim = pybamm.Simulation(model, parameter_values=parameter_values, "
"var_pts=var_pts)"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:189
msgid "We can then solve the model for a 1C and 5C discharge"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[13]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"C_rates = [1, 5]  # C-rates to solve for\n"
"capacity = parameter_values[\"Nominal cell capacity [A.h]\"]\n"
"t_evals = [\n"
"    [0, 3800],\n"
"    [0, 720],\n"
"]  # times to return the solution at\n"
"solutions = [None] * len(C_rates)  # empty list that will hold solutions\n"
"\n"
"# loop over C-rates\n"
"for i, C_rate in enumerate(C_rates):\n"
"    current = C_rate * capacity\n"
"    sim.solve(\n"
"        t_eval=t_evals[i],\n"
"        inputs={\"Current function [A]\": current},\n"
"    )\n"
"    solutions[i] = sim.solution"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:225
msgid "Finally we plot the numerical solution against the experimental data"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid "[14]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:-1
msgid ""
"fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4))\n"
"\n"
"# plot the 1C results\n"
"t_sol = solutions[0][\"Time [s]\"].entries\n"
"ax1.plot(t_sol, solutions[0][\"Voltage [V]\"](t_sol))\n"
"ax1.plot(voltage_data_1C[:, 0], voltage_data_1C[:, 1], \"o\")\n"
"ax1.set_xlabel(\"Time [s]\")\n"
"ax1.set_ylabel(\"Voltage [V]\")\n"
"ax1.set_title(\"1C\")\n"
"ax1.legend([\"DFN\", \"Experiment\"], loc=\"best\")\n"
"\n"
"# plot the 5C results\n"
"t_sol = solutions[1][\"Time [s]\"].entries\n"
"ax2.plot(t_sol, solutions[1][\"Voltage [V]\"](t_sol))\n"
"ax2.plot(voltage_data_5C[:, 0], voltage_data_5C[:, 1], \"o\")\n"
"ax2.set_xlabel(\"Time [s]\")\n"
"ax2.set_ylabel(\"Voltage [V]\")\n"
"ax2.set_title(\"5C\")\n"
"ax2.legend([\"DFN\", \"Experiment\"], loc=\"best\")\n"
"\n"
"plt.tight_layout()\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-ecker-data.ipynb:275
msgid ""
"For a 1C discharge we observe an excellent agreement between the model and "
"experiment, both in terms of the overall shape of the curve and the "
"capacity. The agreement between model and experiment is less good at 5C, but "
"in line with other implementations of the DFN (e.g. `[6] <#References>`__)."
msgstr ""

