#: ../../../source/examples/notebooks/models/saving_models.ipynb:9
msgid "Saving PyBaMM models to file"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:20
msgid ""
"Models which are discretised (i.e. ready to solve/ previously solved, see "
"`this notebook <https://github.com/pybamm-team/PyBaMM/blob/main/docs/source/"
"examples/notebooks/spatial_methods/finite-volumes.ipynb>`__ for more "
"information on the pybamm.Discretisation class) can be serialised and saved "
"to a JSON file, ready to be read in again either in PyBaMM, or a different "
"modelling library."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:22
msgid ""
"In the example below, we build a basic DFN model, and then save the model "
"out to ``sim_model_example.json``, which should have appear in the 'models' "
"directory."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid "[10]:"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid ""
"%pip install pybamm -q    # install PyBaMM if it is not installed\n"
"import pybamm\n"
"\n"
"# do the example\n"
"dfn_model = pybamm.lithium_ion.DFN()\n"
"dfn_sim = pybamm.Simulation(dfn_model)\n"
"# discretise and build the model\n"
"dfn_sim.build()\n"
"\n"
"dfn_sim.save_model(\"sim_model_example\")"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:52
msgid ""
"<pre>\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:58
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:65
msgid "Note: you may need to restart the kernel to use updated packages."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:76
msgid ""
"This model file can then be read in and solved by choosing a solver, and "
"running as below."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid "[11]:"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid ""
"# Recreate the pybamm model from the JSON file\n"
"new_dfn_model = pybamm.load_model(\"sim_model_example.json\")\n"
"\n"
"sim_reloaded = pybamm.Simulation(new_dfn_model)\n"
"sim_reloaded.solve([0, 3600])"
msgstr ""

