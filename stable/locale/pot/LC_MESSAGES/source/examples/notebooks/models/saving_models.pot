#: ../../../source/examples/notebooks/models/saving_models.ipynb:368
msgid ""
"Note that at the moment, only models derived from the BaseBatteryModel class "
"can be serialised; those built from scratch using pybamm.BaseModel() are "
"currently unsupported."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:370
msgid ""
"First set up the model, as explained in detail for the `SPM <https://github."
"com/pybamm-team/PyBaMM/blob/main/docs/source/examples/notebooks/models/SPM."
"ipynb>`__."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid "[14]:"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid ""
"# create the model\n"
"spm_model = pybamm.lithium_ion.SPM()\n"
"\n"
"# set up and discretise ready to solve\n"
"geometry = spm_model.default_geometry\n"
"param = spm_model.default_parameter_values\n"
"param.process_model(spm_model)\n"
"param.process_geometry(geometry)\n"
"mesh = pybamm.Mesh(geometry, spm_model.default_submesh_types, spm_model."
"default_var_pts)\n"
"disc = pybamm.Discretisation(mesh, spm_model.default_spatial_methods)\n"
"disc.process_model(spm_model)"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:402
msgid ""
"<pre>\n"
"&lt;pybamm.models.full_battery_models.lithium_ion.spm.SPM at "
