#: ../../../source/examples/notebooks/models/saving_models.ipynb:126
msgid ""
"It would be nice to plot the results of the two models, to confirm that they "
"are producing the same result."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:128
msgid ""
"However, notice that running the code below generates an error stating that "
"the model variables were not provided during the reading in of the model."
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid "[12]:"
msgstr ""

#: ../../../source/examples/notebooks/models/saving_models.ipynb:-1
msgid ""
"dfn_models = [dfn_model, new_dfn_model]\n"
"sims = []\n"
"for model in dfn_models:\n"
"    plot_sim = pybamm.Simulation(model)\n"
"    plot_sim.solve([0, 3600])\n"
"    sims.append(plot_sim)\n"
"\n"
"pybamm.dynamic_plot(sims, time_unit=\"seconds\")"
msgstr ""

