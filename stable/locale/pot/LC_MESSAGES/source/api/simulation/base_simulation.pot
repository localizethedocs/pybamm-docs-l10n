msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.save_model:1
msgid "Write out a discretised model to a JSON file"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.save_model:3
msgid ""
"The mesh used to discretise the model. If false, plotting tools will not be "
"available when the model is read back in and solved."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.save_model:6
msgid ""
"The discretised variables. Not required to solve a model, but if false tools "
"will not be available. Will automatically save meshes as well, required for "
"plotting tools."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.save_model:10
msgid ""
"The desired name of the JSON file. If no name is provided, one will be "
"created based on the model name, and the current datetime."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:1
msgid ""
"A method to solve the model. This method will automatically build and set "
"the model parameters if not already done so."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:4
msgid ""
"The times at which to stop the integration due to a discontinuity in time. "
"Can be provided as an array of times at which to return the solution, or as "
"a list `[t0, tf]` where `t0` is the initial time and `tf` is the final time. "
"If the solver does not support intra-solve interpolation, providing `t_eval` "
"as a list returns the solution at 100 points within the interval `[t0, tf]`. "
"Otherwise, the solution is returned at the times specified in `t_interp` or "
"as a result of the adaptive time-stepping solution. See the `t_interp` "
"argument for more details.  If not using an experiment or running a drive "
"cycle simulation (current provided as data) `t_eval` *must* be provided.  If "
"None and the parameter \"Current function [A]\" is read from data (i.e. "
"drive cycle simulation) the model will be solved at the times provided in "
"the data."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:4
msgid ""
"The times at which to stop the integration due to a discontinuity in time. "
"Can be provided as an array of times at which to return the solution, or as "
"a list `[t0, tf]` where `t0` is the initial time and `tf` is the final time. "
"If the solver does not support intra-solve interpolation, providing `t_eval` "
"as a list returns the solution at 100 points within the interval `[t0, tf]`. "
"Otherwise, the solution is returned at the times specified in `t_interp` or "
"as a result of the adaptive time-stepping solution. See the `t_interp` "
"argument for more details."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:13
msgid ""
"If not using an experiment or running a drive cycle simulation (current "
"provided as data) `t_eval` *must* be provided."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:16
msgid ""
"If None and the parameter \"Current function [A]\" is read from data (i.e. "
"drive cycle simulation) the model will be solved at the times provided in "
"the data."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:20
msgid ""
"The solver to use to solve the model. If None, Simulation.solver is used"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:22
msgid ""
"Whether to include eSOH variables in the summary variables. If `False` then "
"only summary variables that do not require the eSOH calculation are "
"calculated. If given, overwrites the default provided by the model."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:31
msgid ""
"A list of callbacks to be called at each time step. Each callback must "
"implement all the methods defined in :class:`pybamm.callbacks.BaseCallback`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:34
msgid ""
"The times (in seconds) at which to interpolate the solution. Defaults to "
"None. Only valid for solvers that support intra-solve interpolation "
"(`IDAKLUSolver`)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.solve:37
msgid ""
"Additional key-word arguments passed to `solver.solve`. See :meth:`pybamm."
"BaseSolver.solve`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.step:1
msgid ""
"A method to step the model forward one timestep. This method will "
"automatically build and set the model parameters if not already done so."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.step:4
msgid "The timestep over which to step the solution"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.step:8
msgid ""
"An array of times at which to return the solution during the step (Note: "
"t_eval is the time measured from the start of the step, so should start at 0 "
"and end at dt). By default, the solution is returned at t0 and t0 + dt."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.step:12
msgid "Turn on to store the solution of all previous timesteps"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.step:14
msgid ""
"The solution to start stepping from. If None (default), then self._solution "
"is used"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of pybamm.simulation.base_simulation.BaseSimulation.step:17
msgid ""
"Additional key-word arguments passed to `solver.solve`. See :meth:`pybamm."
"BaseSolver.step`."
msgstr ""

