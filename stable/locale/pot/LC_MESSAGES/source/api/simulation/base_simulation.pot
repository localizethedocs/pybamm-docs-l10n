"Whether to show the overpotentials for the negative and positive electrodes "
"separately. Default is False."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of
#: pybamm.simulation.base_simulation.BaseSimulation.plot_voltage_components:10
msgid ""
"The phases for which to plot the anode and cathode overpotentials, "
"respectively. Default is `(\"primary\", \"primary\")`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/base_simulation.py:docstring
#: of
#: pybamm.simulation.base_simulation.BaseSimulation.plot_voltage_components:13
