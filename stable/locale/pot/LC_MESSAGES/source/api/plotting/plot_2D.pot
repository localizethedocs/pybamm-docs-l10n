#: ../../../source/api/plotting/plot_2D.rst:2
msgid "Plot 2D"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot2D.py:docstring
#: of pybamm.plotting.plot2D.plot2D:1
msgid ""
"Generate a simple 2D plot. Calls `matplotlib.pyplot.contourf` with keyword "
"arguments 'kwargs'.  For a list of 'kwargs' see the `matplotlib contourf "
"documentation <https://matplotlib.org/stable/api/_as_gen/matplotlib.pyplot."
"contourf.html>`_"
msgstr ""

#: ../../../source/api/plotting/plot_2D.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot2D.py:docstring
#: of pybamm.plotting.plot2D.plot2D:6
msgid "The array to plot on the x axis. Can be of shape (M, N) or (N, 1)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot2D.py:docstring
#: of pybamm.plotting.plot2D.plot2D:8
msgid "The array to plot on the y axis. Can be of shape (M, N)  or (M, 1)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot2D.py:docstring
#: of pybamm.plotting.plot2D.plot2D:10
msgid "The array to plot on the z axis. Is of shape (M, N)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot2D.py:docstring
#: of pybamm.plotting.plot2D.plot2D:12
msgid ""
"The axis on which to put the plot. If None, a new figure and axis is created."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot2D.py:docstring
#: of pybamm.plotting.plot2D.plot2D:14
msgid ""
"Whether to show the plots. Default is True. Set to False if you want to only "
"display the plot after plt.show() has been called."
msgstr ""
