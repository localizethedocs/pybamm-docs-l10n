msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/parameter.py:docstring
#: of pybamm.expression_tree.parameter.FunctionParameter:3
msgid ""
"This node will be replaced by a :class:`pybamm.Function` node if a callable "
"function is passed to the parameter values, and otherwise (in some rarer "
"cases, such as constant current) a :class:`pybamm.Scalar` node."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/parameter.py:docstring
#: of pybamm.expression_tree.parameter.FunctionParameter:9
msgid ""
"A dictionary with string keys and :class:`pybamm.Symbol` values representing "
"the function inputs. The string keys should provide a reasonable description "
"of what the input to the function is (e.g. \"Electrolyte concentration [mol."
"m-3]\")"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/parameter.py:docstring
#: of pybamm.expression_tree.parameter.FunctionParameter:14
msgid ""
"if diff_variable is specified, the FunctionParameter node will be replaced "
"by a :class:`pybamm.Function` and then differentiated with respect to "
"diff_variable. Default is None."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/parameter.py:docstring
#: of pybamm.expression_tree.parameter.FunctionParameter:18
msgid ""
"The name to show when printing. Default is 'calculate', in which case the "
"name is calculated using sys._getframe()."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/parameter.py:docstring
#: of pybamm.expression_tree.parameter.FunctionParameter:21
msgid ""
"A callable that takes a pybamm.Symbol and returns a pybamm.Symbol. If "
"provided, it will be applied to the function output after the function is "
"evaluated during parameter processing. This can be used to apply "
"regularisation or other transformations. Default is None."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/parameter.py:docstring
