#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/event.py:docstring
#: of pybamm.models.event.EventType:3
msgid ""
"TERMINATION indicates an event that will terminate the solver, the "
"expression should return 0 when the event is triggered"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/event.py:docstring
#: of pybamm.models.event.EventType:6
msgid ""
"DISCONTINUITY indicates an expected discontinuity in the solution, the "
"expression should return the time that the discontinuity occurs. The solver "
"will integrate up to the discontinuity and then restart just after the "
"discontinuity."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/event.py:docstring
#: of pybamm.models.event.EventType:10
msgid ""
"INTERPOLANT_EXTRAPOLATION indicates that a pybamm.Interpolant object has "
"been evaluated outside of the range."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/event.py:docstring
#: of pybamm.models.event.EventType:13
msgid ""
"SWITCH indicates an event switch that is used in CasADI \"fast with events\" "
"model."
msgstr ""

