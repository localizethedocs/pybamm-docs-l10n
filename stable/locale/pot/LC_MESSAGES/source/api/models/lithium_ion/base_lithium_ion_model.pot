msgid "Base Lithium-ion Model"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel:1
msgid ""
"Overwrites default parameters from Base Model with default parameters for "
"lithium-ion models"
msgstr ""

#: ../../../source/api/models/lithium_ion/base_lithium_ion_model.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel:4
msgid ""
"A dictionary of options to be passed to the model. If this is a dict (and "
"not a subtype of dict), it will be processed by :class:`pybamm."
"BatteryModelOptions` to ensure that the options are valid. If this is a "
"subtype of dict, it is assumed that the options have already been processed "
"and are valid. This allows for the use of custom options classes. The "
"default options are given by :class:`pybamm.BatteryModelOptions`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel:11
msgid "The name of the model. The default is \"Unnamed battery model\"."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel:13
msgid ""
"Whether to build the model on instantiation. Default is True. Setting this "
"option to False allows users to change any number of the submodels before "
"building the complete model (submodels cannot be changed after the model is "
"built)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel:19
msgid ""
"**Extends:** :class:`pybamm.models.full_battery_models.base_battery_model."
"BaseBatteryModel`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel:0
msgid "View inheritance diagram for this model"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of pybamm.lithium_ion.BaseModel.calc_esoh:1
msgid "Whether to include eSOH variables in the summary variables."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of pybamm.lithium_ion.BaseModel.default_parameter_values:1
msgid ""
"Returns the default parameter values for the model (an empty set of "
"parameters by default)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of pybamm.lithium_ion.BaseModel.default_quick_plot_variables:1
msgid "Returns the default variables for quick plotting (None by default)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel.insert_reference_electrode:1
msgid ""
"Insert a reference electrode to measure the electrolyte potential at a given "
"position in space. Adds model variables for the electrolyte potential at the "
"reference electrode and for the potential difference between the electrode "
"potentials measured at the electrode/current collector interface and the "
"reference electrode. Only implemented for 1D models (i.e. where the "
"'dimensionality' option is 0)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel.insert_reference_electrode:8
msgid ""
"The position in space at which to measure the electrolyte potential. If "
"None, defaults to the mid-point of the separator."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel.set_default_summary_variables:1
msgid "Sets the default summary variables."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/base_lithium_ion_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.base_lithium_ion_model.BaseModel.set_degradation_variables:1
msgid "Sets variables that quantify degradation (LAM, LLI, etc)"
msgstr ""
