#: ../../../source/api/models/submodels/base_submodel.rst:2
msgid "Base Submodel"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:1
msgid ""
"The base class for all submodels. All submodels inherit from this class and "
"must only provide public methods which overwrite those in this base class. "
"Any methods added to a submodel that do not overwrite those in this bass "
"class are made private with the prefix '_', providing a consistent public "
"interface for all submodels."
msgstr ""

#: ../../../source/api/models/submodels/base_submodel.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:7
msgid "The model parameter symbols"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:9
msgid "The domain of the model either 'Negative' or 'Positive'"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:11
msgid "A string giving the name of the submodel"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:13
msgid ""
"Whether the variables defined by the submodel will be provided externally by "
"the users. Default is 'False'."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:16
msgid ""
"A dictionary of options to be passed to the model. See :class:`pybamm."
"BaseBatteryModel`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:19
msgid "Phase of the particle (default is None)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:24
msgid "The model parameter symbols."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:0
msgid "type"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:26
msgid "parameter class"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:30
msgid ""
"The domain of the submodel, could be either 'Negative', 'Positive', "
"'Separator', or None."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:32
#: pybamm.models.submodels.base_submodel.BaseSubModel:38
#: pybamm.models.submodels.base_submodel.BaseSubModel:59
msgid "str"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:36
msgid "The name of the submodel."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:42
msgid ""
"A boolean flag indicating whether the variables defined by the submodel will "
"be provided externally by the user. Set to False by default."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:45
msgid "bool"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:49
msgid ""
"A dictionary or an instance of `pybamm.BatteryModelOptions` that stores "
"configuration options for the submodel."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:52
msgid "dict or pybamm.BatteryModelOptions"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:56
msgid ""
"A string representing the phase of the submodel, which could be \"primary\", "
"\"secondary\", or an empty string if there is only one phase."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:63
msgid ""
"The current phase of the submodel, which could be \"primary\", "
"\"secondary\", or None."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:65
msgid "str or None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:69
msgid "A dictionary mapping variables to their respective boundary conditions."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:71
#: pybamm.models.submodels.base_submodel.BaseSubModel:78
msgid "dict"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:75
msgid ""
"A dictionary mapping variable names (strings) to expressions or objects that "
"represent the useful variables for the submodel."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:80
msgid "**Extends:** :class:`pybamm.models.base_model.BaseModel`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel:0
msgid "View inheritance diagram for this model"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel.add_events_from:1
msgid ""
"A method to set events related to the state of submodel variable. Note: this "
"method modifies the state of self.events. Unless overwritten by a submodel, "
"the default behaviour of 'pass' is used as implemented in :class:`pybamm."
"BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel.add_events_from:6
#: pybamm.models.submodels.base_submodel.BaseSubModel.get_coupled_variables:8
#: pybamm.models.submodels.base_submodel.BaseSubModel.set_algebraic:6
#: pybamm.models.submodels.base_submodel.BaseSubModel.set_boundary_conditions:6
#: pybamm.models.submodels.base_submodel.BaseSubModel.set_initial_conditions:7
#: pybamm.models.submodels.base_submodel.BaseSubModel.set_rhs:6
msgid "The variables in the whole model."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.BaseSubModel.domain_Domain:1
msgid "Returns a tuple containing the current domain and its capitalized form."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of
#: pybamm.models.submodels.base_submodel.BaseSubModel.get_coupled_variables:1
msgid ""
"A public method that creates and returns the variables in a submodel which "
"require variables in other submodels to be set first. For example, the "
"exchange current density requires the concentration in the electrolyte to be "
"created before it can be created. If a variable can be created independent "
"of other submodels then it should be created in 'get_fundamental_variables' "
"instead of this method."
msgstr ""

#: ../../../source/api/models/submodels/base_submodel.rst:0
msgid "Returns"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of
#: pybamm.models.submodels.base_submodel.BaseSubModel.get_coupled_variables:11
msgid ""
"The variables created in this submodel which depend on variables in other "
"submodels."
msgstr ""

#: ../../../source/api/models/submodels/base_submodel.rst:0
msgid "Return type"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of
#: pybamm.models.submodels.base_submodel.BaseSubModel.get_fundamental_variables:1
msgid ""
"A public method that creates and returns the variables in a submodel which "
"can be created independent of other submodels. For example, the electrolyte "
"concentration variables can be created independent of whether any other "
"variables have been defined in the model. As a rule, if a variable can be "
"created without variables from other submodels, then it should be placed in "
"this method."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of
#: pybamm.models.submodels.base_submodel.BaseSubModel.get_fundamental_variables:8
msgid ""
"The variables created by the submodel which are independent of variables in "
"other submodels."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel.get_parameter_info:1
msgid ""
"Extracts the parameter information and returns it as a dictionary. To get a "
"list of all parameter-like objects without extra information, use :py:attr:"
"`model.parameters`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel.set_algebraic:1
msgid ""
"A method to set the differential equations which do not contain a time "
"derivative. Note: this method modifies the state of self.algebraic. Unless "
"overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of
#: pybamm.models.submodels.base_submodel.BaseSubModel.set_boundary_conditions:1
msgid ""
"A method to set the boundary conditions for the submodel. Note: this method "
"modifies the state of self.boundary_conditions. Unless overwritten by a "
"submodel, the default behaviour of 'pass' is used as implemented in :class:"
"`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of
#: pybamm.models.submodels.base_submodel.BaseSubModel.set_initial_conditions:1
msgid ""
"A method to set the initial conditions for the submodel. Note: this method "
"modifies the state of self.initial_conditions. Unless overwritten by a "
"submodel, the default behaviour of 'pass' is used as implemented in :class:"
"`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/base_submodel.py:docstring
#: of pybamm.models.submodels.base_submodel.BaseSubModel.set_rhs:1
msgid ""
"A method to set the right hand side of the differential equations which "
"contain a time derivative. Note: this method modifies the state of self.rhs. "
"Unless overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""
