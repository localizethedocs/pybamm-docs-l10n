msgid "X-averaged Polynomial Profile"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile:1
msgid ""
"Class for molar conservation in a single x-averaged particle employing "
"Fick's law, with an assumed polynomial concentration profile in r. Model "
"equations from :footcite:t:`Subramanian2005`."
msgstr ""

