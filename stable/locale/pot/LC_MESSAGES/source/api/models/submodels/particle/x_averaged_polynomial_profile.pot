#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.set_algebraic:6
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.set_rhs:6
msgid "The variables in the whole model."
msgstr ""

#: ../../../source/api/models/submodels/particle/x_averaged_polynomial_profile.rst:0
msgid "Returns"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.get_coupled_variables:11
msgid ""
"The variables created in this submodel which depend on variables in other "
"submodels."
msgstr ""

#: ../../../source/api/models/submodels/particle/x_averaged_polynomial_profile.rst:0
msgid "Return type"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.get_fundamental_variables:1
msgid ""
"A public method that creates and returns the variables in a submodel which "
"can be created independent of other submodels. For example, the electrolyte "
"concentration variables can be created independent of whether any other "
"variables have been defined in the model. As a rule, if a variable can be "
"created without variables from other submodels, then it should be placed in "
"this method."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.get_fundamental_variables:8
msgid ""
"The variables created by the submodel which are independent of variables in "
"other submodels."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.set_algebraic:1
msgid ""
"A method to set the differential equations which do not contain a time "
"derivative. Note: this method modifies the state of self.algebraic. Unless "
"overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.set_initial_conditions:1
msgid ""
"For single or x-averaged particle models, initial conditions can't depend on "
"x or r so we take the r- and x-average of the initial conditions."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/particle/x_averaged_polynomial_profile.py:docstring
#: of
#: pybamm.models.submodels.particle.x_averaged_polynomial_profile.XAveragedPolynomialProfile.set_rhs:1
msgid ""
"A method to set the right hand side of the differential equations which "
"contain a time derivative. Note: this method modifies the state of self.rhs. "
"Unless overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""

