#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import matplotlib.pyplot as plt\n"
"import numpy as np\n"
"\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:44
msgid "Running a basic EIS simulation"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:46
msgid ""
"To run an EIS simulation we need a model with the ``\"surface form\"`` "
"option set to ``\"differential\"``. We pass the model to ``pybamm."
"EISSimulation``, define the frequencies of interest, and call ``solve``:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"model = pybamm.lithium_ion.SPM(options={\"surface form\": "
"\"differential\"})\n"
"eis_sim = pybamm.EISSimulation(model)\n"
"\n"
"frequencies = np.logspace(-4, 4, 30)  # 10^-4 to 10^4 Hz\n"
"result = eis_sim.solve(frequencies)\n"
"result"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:73
msgid ""
"<pre>\n"
"&lt;pybamm.solvers.solution.EISSolution at 0x11f379fd0&gt;\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:79
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"<pybamm.solvers.solution.EISSolution at 0x11f379fd0>\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:86
msgid "<pybamm.solvers.solution.EISSolution at 0x11f379fd0>"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:97
msgid ""
"The ``solve`` method returns an ``EISSolution`` object. Like the time-series "
"``Solution``, it is also a ``SolutionBase`` instance, stores timing "
"information, and is accessible via the ``solution`` property on the "
"simulation — the same pattern as ``Simulation.solution``:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"print(f\"isinstance EISSolution:  {isinstance(result, pybamm."
"EISSolution)}\")\n"
"print(f\"isinstance SolutionBase: {isinstance(result, pybamm."
"SolutionBase)}\")\n"
"print(f\"Set-up time: {result.set_up_time}\")\n"
"print(f\"Solve time:  {result.solve_time}\")\n"
"print(f\"Same as eis_sim.solution: {result is eis_sim.solution}\")"
msgstr ""

