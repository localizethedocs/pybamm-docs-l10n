#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:346
msgid "Nyquist plots"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:348
msgid ""
"The standard way to visualise EIS data is a Nyquist plot, which shows the "
"real part of impedance on the x-axis and the negative imaginary part on the "
"y-axis. ``EISSolution`` has a built-in method for this:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"result.nyquist_plot(show_plot=False)\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:378
msgid "You can also build custom plots directly from the solution data:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n"
"\n"
"# Nyquist plot from dict-style access\n"
"axes[0].plot(result[\"Z_re [Ohm]\"], -result[\"Z_im [Ohm]\"], \"o-\")\n"
"axes[0].set_xlabel(r\"$Z_\\mathrm{Re}$ [Ohm]\")\n"
"axes[0].set_ylabel(r\"$-Z_\\mathrm{Im}$ [Ohm]\")\n"
"axes[0].set_title(\"Nyquist plot\")\n"
"axes[0].set_aspect(\"equal\")\n"
"\n"
"# Bode-style: magnitude vs frequency\n"
"Z = result[\"Impedance [Ohm]\"]\n"
"axes[1].loglog(result[\"Frequency [Hz]\"], np.abs(Z), \"o-\")\n"
"axes[1].set_xlabel(\"Frequency [Hz]\")\n"
"axes[1].set_ylabel(\"|Z| [Ohm]\")\n"
"axes[1].set_title(\"Bode magnitude\")\n"
"\n"
"fig.tight_layout()\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:425
msgid "SOC sweep"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:427
msgid ""
"Battery impedance changes with the state of charge. We can sweep SOC by "
"passing ``initial_soc`` to ``solve``:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[7]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"model = pybamm.lithium_ion.SPM(options={\"surface form\": "
"\"differential\"})\n"
"parameter_values = pybamm.ParameterValues(\"Chen2020\")\n"
"eis_sim = pybamm.EISSimulation(model, parameter_values=parameter_values)\n"
"\n"
"frequencies = np.logspace(-4, 4, 30)\n"
"_, ax = plt.subplots()\n"
"\n"
"for soc in [0.2, 0.5, 0.9]:\n"
"    result = eis_sim.solve(frequencies, initial_soc=soc)\n"
"    ax.plot(\n"
"        result[\"Z_re [Ohm]\"],\n"
"        -result[\"Z_im [Ohm]\"],\n"
"        \"o\",\n"
"        label=f\"SOC = {soc}\",\n"
"    )\n"
"\n"
"ax.set_xlabel(r\"$Z_\\mathrm{Re}$ [Ohm]\")\n"
"ax.set_ylabel(r\"$-Z_\\mathrm{Im}$ [Ohm]\")\n"
"ax.set_aspect(\"equal\")\n"
"ax.legend()\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:477
msgid "Comparing models"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:479
msgid ""
"We can compare the impedance predicted by different electrochemical models. "
"All models must use ``\"surface form\": \"differential\"`` for EIS:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"models = {\n"
"    \"SPM\": pybamm.lithium_ion.SPM(options={\"surface form\": "
"\"differential\"}),\n"
"    \"SPMe\": pybamm.lithium_ion.SPMe(options={\"surface form\": "
"\"differential\"}),\n"
"    \"DFN\": pybamm.lithium_ion.DFN(options={\"surface form\": "
"\"differential\"}),\n"
"}\n"
"\n"
"frequencies = np.logspace(-4, 4, 30)\n"
"_, ax = plt.subplots()\n"
"\n"
"for name, model in models.items():\n"
"    eis_sim = pybamm.EISSimulation(model)\n"
"    result = eis_sim.solve(frequencies)\n"
"    ax.plot(\n"
"        result[\"Z_re [Ohm]\"],\n"
"        -result[\"Z_im [Ohm]\"],\n"
"        \"o\",\n"
"        label=name,\n"
"    )\n"
"\n"
"ax.set_xlabel(r\"$Z_\\mathrm{Re}$ [Ohm]\")\n"
"ax.set_ylabel(r\"$-Z_\\mathrm{Im}$ [Ohm]\")\n"
"ax.set_aspect(\"equal\")\n"
"ax.legend()\n"
"plt.show()"
msgstr ""

