#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:161
msgid ""
"The ``EISSolution`` supports dict-style access, just like the time-series "
"``Solution``. You can use ``result[\"Variable name\"]`` to get data arrays:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:-1
msgid ""
"# Dict-style access — same API as Solution\n"
"print(\"Frequencies (Hz):\\n\", result[\"Frequency [Hz]\"])\n"
"print(\"\\nComplex impedance:\\n\", result[\"Impedance [Ohm]\"])\n"
"print(\"\\nReal part:\\n\", result[\"Z_re [Ohm]\"])\n"
"print(\"\\nImaginary part:\\n\", result[\"Z_im [Ohm]\"])\n"
"\n"
"# Convenience properties also available\n"
"print(\"\\nVia property:\", result.impedance[:3], \"...\")"
