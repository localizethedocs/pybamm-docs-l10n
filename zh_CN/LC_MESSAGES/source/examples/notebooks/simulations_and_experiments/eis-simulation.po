#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:9
msgid "EIS Simulation"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:11
msgid ""
"Electrochemical Impedance Spectroscopy (EIS) is a technique for "
"characterising battery dynamics by applying a small sinusoidal perturbation "
"at different frequencies and measuring the resulting impedance. PyBaMM "
"provides ``EISSimulation``, a frequency-domain solver that computes "
"impedance spectra directly — much faster than running full time-domain "
"simulations at each frequency."
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:13
msgid "In this notebook we will:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:15
msgid "Run a basic EIS simulation and inspect the solution"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:16
msgid "Access and plot impedance data (Nyquist plots)"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:17
msgid "Compare impedance at different states of charge (SOC)"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:18
msgid "Compare impedance across different models"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/eis-simulation.ipynb:19
msgid "Save EIS data to file"
msgstr ""

