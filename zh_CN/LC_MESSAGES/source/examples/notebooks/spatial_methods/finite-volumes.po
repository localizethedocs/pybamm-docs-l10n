"\"version_minor\": 0}</script>"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:1841
msgid ""
"This gives the expected linear steady state from 0 to 1. Similarly, if the "
"velocity is negative, downwinding gives accurate results"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[33]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"model.rhs = {c: -pybamm.div(pybamm.downwind(c) * (-v)) + 1}\n"
"model.boundary_conditions = {c: {\"right\": (0, \"Dirichlet\")}}\n"
"solve_and_plot(model)"
msgstr ""

