#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:115
msgid ""
"To set up a discretisation, we must create a geometry, mesh this geometry, "
"and then create the discretisation with the appropriate spatial method(s). "
"The easiest way to create a geometry is to the inbuilt battery geometry:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"parameter_values = pybamm.ParameterValues(\n"
"    values={\n"
"        \"Negative particle radius [m]\": 0.5,\n"
"        \"Positive particle radius [m]\": 0.6,\n"
"        \"Negative electrode thickness [m]\": 0.3,\n"
"        \"Separator thickness [m]\": 0.2,\n"
"        \"Positive electrode thickness [m]\": 0.3,\n"
"    }\n"
")\n"
"\n"
"geometry = pybamm.battery_geometry()\n"
"parameter_values.process_geometry(geometry)"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:147
msgid ""
"We then use this geometry to create a mesh, which for this example consists "
"of uniform 1D submeshes"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"submesh_types = {\n"
"    \"negative electrode\": pybamm.Uniform1DSubMesh,\n"
"    \"separator\": pybamm.Uniform1DSubMesh,\n"
"    \"positive electrode\": pybamm.Uniform1DSubMesh,\n"
"    \"negative particle\": pybamm.Uniform1DSubMesh,\n"
"    \"positive particle\": pybamm.Uniform1DSubMesh,\n"
"    \"current collector\": pybamm.SubMesh0D,\n"
"}\n"
"\n"
"var = pybamm.standard_spatial_vars\n"
"var_pts = {var.x_n: 15, var.x_s: 10, var.x_p: 15, var.r_n: 10, var.r_p: 10}\n"
"mesh = pybamm.Mesh(geometry, submesh_types, var_pts)"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:179
msgid ""
"Finally, we can use the mesh to create a discretisation, using Finite "
"Volumes as the spatial method for this example"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"spatial_methods = {\n"
"    \"macroscale\": pybamm.FiniteVolume(),\n"
"    \"negative particle\": pybamm.FiniteVolume(),\n"
"    \"positive particle\": pybamm.FiniteVolume(),\n"
"}\n"
"disc = pybamm.Discretisation(mesh, spatial_methods)"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:206
msgid "Discretisations and Spatial Methods"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:218
msgid "Spatial Variables"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:229
msgid ""
"Spatial variables, such as :math:`x` and :math:`r`, are converted to "
"``pybamm.Vector`` nodes"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"# Set up\n"
"macroscale = [\"negative electrode\", \"separator\", \"positive "
"electrode\"]\n"
"x_var = pybamm.SpatialVariable(\"x\", domain=macroscale)\n"
"r_var = pybamm.SpatialVariable(\"r\", domain=[\"negative particle\"])\n"
"\n"
"# Discretise\n"
"x_disc = disc.process_symbol(x_var)\n"
"r_disc = disc.process_symbol(r_var)\n"
"print(f\"x_disc is a {type(x_disc)}\")\n"
"print(f\"r_disc is a {type(r_disc)}\")\n"
"\n"
"# Evaluate\n"
"x = x_disc.evaluate()\n"
"r = r_disc.evaluate()\n"
"\n"
"f, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4))\n"
"\n"
"ax1.plot(x, \"*\")\n"
"ax1.set_xlabel(\"index\")\n"
"ax1.set_ylabel(r\"$x$\")\n"
"\n"
"ax2.plot(r, \"*\")\n"
"ax2.set_xlabel(\"index\")\n"
"ax2.set_ylabel(r\"$r$\")\n"
"\n"
"plt.tight_layout()\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:277
msgid ""
"<pre>\n"
"x_disc is a &lt;class &#39;pybamm.expression_tree.vector.Vector&#39;&gt;\n"
"r_disc is a &lt;class &#39;pybamm.expression_tree.vector.Vector&#39;&gt;\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:284
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"x\\_disc is a <class 'pybamm.expression\\_tree.vector.Vector'>\n"
"r\\_disc is a <class 'pybamm.expression\\_tree.vector.Vector'>\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:292
msgid ""
"x_disc is a <class 'pybamm.expression_tree.vector.Vector'>\n"
"r_disc is a <class 'pybamm.expression_tree.vector.Vector'>"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:312
msgid ""
"We define ``y_macroscale``, ``y_microscale`` and ``y_scalar`` for evaluation "
"and visualisation of results below"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"y_macroscale = x**3 / 3\n"
"y_microscale = np.cos(r)\n"
"y_scalar = np.array([[5]])\n"
"\n"
"y = np.concatenate([y_macroscale, y_microscale, y_scalar])"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:338
msgid "Variables"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:349
msgid ""
"In this notebook, we will work with three variables ``u``, ``v``, ``w``."
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[7]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"u = pybamm.Variable(\n"
"    \"u\", domain=macroscale\n"
")  # u is a variable in the macroscale (e.g. electrolyte potential)\n"
"v = pybamm.Variable(\n"
"    \"v\", domain=[\"negative particle\"]\n"
")  # v is a variable in the negative particle (e.g. particle concentration)\n"
"w = pybamm.Variable(\n"
"    \"w\"\n"
")  # w is a variable without a domain (e.g. time, average concentration)\n"
"\n"
"variables = [u, v, w]"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:380
msgid ""
"Before discretising, trying to evaluate the variables raises a "
"``NotImplementedError``:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"try:\n"
"    u.evaluate()\n"
"except NotImplementedError as e:\n"
"    print(e)"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:404
msgid ""
"<pre>\n"
"method self.evaluate() not implemented for symbol u of type &lt;class &#39;"
"pybamm.expression_tree.variable.Variable&#39;&gt;\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:410
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"method self.evaluate() not implemented for symbol u of type <class 'pybamm."
"expression\\_tree.variable.Variable'>\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:417
msgid ""
"method self.evaluate() not implemented for symbol u of type <class 'pybamm."
"expression_tree.variable.Variable'>"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:428
msgid ""
"For any spatial method, a ``pybamm.Variable`` gets converted to a ``pybamm."
"StateVector`` which, when evaluated, takes the appropriate slice of the "
"input vector ``y``."
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[9]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"# Pass the list of variables to the discretisation to calculate the slices "
"to be used (order matters here!)\n"
"disc.set_variable_slices(variables)\n"
"\n"
"# Discretise the variables\n"
"u_disc = disc.process_symbol(u)\n"
"v_disc = disc.process_symbol(v)\n"
"w_disc = disc.process_symbol(w)\n"
"\n"
"# Print the outcome\n"
"print(f\"Discretised u is the StateVector {u_disc}\")\n"
"print(f\"Discretised v is the StateVector {v_disc}\")\n"
"print(f\"Discretised w is the StateVector {w_disc}\")"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:460
msgid ""
"<pre>\n"
"Discretised u is the StateVector y[0:40]\n"
"Discretised v is the StateVector y[40:50]\n"
"Discretised w is the StateVector y[50:51]\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:468
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"Discretised u is the StateVector y[0:40]\n"
"Discretised v is the StateVector y[40:50]\n"
"Discretised w is the StateVector y[50:51]\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:477
msgid ""
"Discretised u is the StateVector y[0:40]\n"
"Discretised v is the StateVector y[40:50]\n"
"Discretised w is the StateVector y[50:51]"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:490
msgid ""
"Since the variables have been passed to ``disc`` in the order ``[u,v,w]``, "
"they each read the appropriate part of ``y`` when evaluated:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[10]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"x_fine = np.linspace(x[0], x[-1], 1000)\n"
"r_fine = np.linspace(r[0], r[-1], 1000)\n"
"\n"
"fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4))\n"
"ax1.plot(x_fine, x_fine**3 / 3, x, u_disc.evaluate(y=y), \"o\")\n"
"ax1.set_xlabel(\"x\")\n"
"ax1.legend([\"x^3/3\", \"u\"], loc=\"best\")\n"
"\n"
"ax2.plot(r_fine, np.cos(r_fine), r, v_disc.evaluate(y=y), \"o\")\n"
"ax2.set_xlabel(\"r\")\n"
"ax2.legend([\"cos(r)\", \"v\"], loc=\"best\")\n"
"\n"
"plt.tight_layout()\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[11]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "print(f\"w = {w_disc.evaluate(y=y)}\")"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:542
