#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:905
msgid "Boundary conditions"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:916
msgid ""
"If the discretisation is provided with boundary conditions, appropriate "
"ghost nodes are concatenated onto the variable, and a larger gradient matrix "
"is used. The ghost nodes are chosen based on the value of the first/last "
"node in the variable and the boundary condition. For a Dirichlet boundary "
"condition :math:`u=a` on the left-hand boundary, we set the value of the "
"left ghost node to be equal to"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:918
msgid ""
"2*a-u[0],\n"
"\n"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:920
msgid ""
"where :math:`u[0]` is the value of :math:`u` in the left-most cell in the "
"domain. Similarly, for a Dirichlet condition :math:`u=b` on the right-hand "
"boundary, we set the right ghost node to be"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:922
msgid ""
"2*b-u[-1].\n"
"\n"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[17]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"disc.bcs = {\n"
"    u: {\n"
"        \"left\": (pybamm.Scalar(1), \"Dirichlet\"),\n"
"        \"right\": (pybamm.Scalar(2), \"Dirichlet\"),\n"
"    }\n"
"}\n"
"grad_u_disc = disc.process_symbol(grad_u)\n"
"print(\"The gradient object is:\")\n"
"(grad_u_disc.render())\n"
"u_eval = grad_u_disc.evaluate(y=y)\n"
"dx = np.diff(macro_mesh.nodes)[-1]\n"
"print(f\"The value of u on the left-hand boundary is {y[0] - dx * "
"u_eval[0] / 2}\")\n"
"print(f\"The value of u on the right-hand boundary is {y[1] + dx * "
"u_eval[-1] / 2}\")"
msgstr ""

