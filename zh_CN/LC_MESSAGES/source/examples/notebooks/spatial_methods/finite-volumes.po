#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:1784
msgid ""
"The concentration grows indefinitely, which is clearly an incorrect "
"solution. Instead, we can use upwinding:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid "[32]:"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:-1
msgid ""
"model.rhs = {c: -pybamm.div(pybamm.upwind(c) * v) + 1}\n"
"solve_and_plot(model)"
msgstr ""

#: ../../../source/examples/notebooks/spatial_methods/finite-volumes.ipynb:1807
