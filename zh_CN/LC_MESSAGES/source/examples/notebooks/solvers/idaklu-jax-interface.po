msgid ""
"<pre>\n"
"Value and gradient computed in 0.095 secs\n"
"SSE value:  0.0020846163677995366\n"
"SSE gradient (wrt each input):  {&#39;Current function [A]&#39;: "
"array(-0.05775429), &#39;Separator porosity&#39;: array(0.00146983)}\n"
"</pre>"
msgstr ""

