"        time += sol.integration_time\n"
"    print(f\"Smooth, k={k}:\", time / 100)\n"
"    sols.append(sol)\n"
"\n"
"pybamm.dynamic_plot(\n"
"    sols, [\"x\", \"max(x,1)\"], labels=[\"exact\"] + [f\"soft (k={k})\" for "
"k in ks]\n"
");"
msgstr ""

