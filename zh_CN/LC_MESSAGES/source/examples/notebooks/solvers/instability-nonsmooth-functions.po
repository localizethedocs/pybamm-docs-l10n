msgid ""
"For the minimum and maximum functions, an alternative smoothing functions "
"(smooth_max, smooth_min) are provided."
msgstr ""

#: ../../../source/examples/notebooks/solvers/instability-nonsmooth-functions.ipynb:405
msgid ""
"\\textrm{min}(x, y) = 0.5 * (\\sqrt((x - y)^2 + \\sigma) + (x + y))\n"
"\\quad , \\quad\n"
"\\textrm{max}(x, y) = 0.5 * ((x + y) - \\sqrt((x - y)^2 + \\sigma))"
msgstr ""

#: ../../../source/examples/notebooks/solvers/instability-nonsmooth-functions.ipynb:412
msgid "where"
msgstr ""

#: ../../../source/examples/notebooks/solvers/instability-nonsmooth-functions.ipynb:414
msgid "\\sigma = \\frac{1}{k^2}"
msgstr ""

#: ../../../source/examples/notebooks/solvers/instability-nonsmooth-functions.ipynb:419
msgid ""
"For the smooth minimum and maximum functions, the recommended value of k is "
"100, where the function closely approximates the exact function, but is "
"differentiable."
msgstr ""

