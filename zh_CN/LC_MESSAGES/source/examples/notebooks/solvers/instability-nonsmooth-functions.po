#: ../../../source/examples/notebooks/solvers/instability-nonsmooth-functions.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/solvers/instability-nonsmooth-functions.ipynb:-1
msgid ""
"model_exact = pybamm.BaseModel()\n"
"model_exact.rhs = {x: pybamm.maximum(x, 1)}\n"
