#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:152
msgid ""
"Let's plot a comparison of the 3E potentials and the potential difference "
"between the solid and electrolyte phases at the electrode/separator "
"interfaces"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid ""
"sim.plot(\n"
"    [\n"
"        [\n"
"            \"Negative electrode surface potential difference at separator "
"interface [V]\",\n"
"            \"Negative electrode 3E potential [V]\",\n"
"        ],\n"
"        [\n"
"            \"Positive electrode surface potential difference at separator "
"interface [V]\",\n"
"            \"Positive electrode 3E potential [V]\",\n"
"        ],\n"
"        \"Voltage [V]\",\n"
"    ]\n"
")"
msgstr ""

