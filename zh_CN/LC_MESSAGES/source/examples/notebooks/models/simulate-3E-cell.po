#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:9
msgid "Simulating a 3E cell"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:11
msgid ""
"In this notebook we show how to insert a reference electrode to mimic a 3E "
"cell."
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:33
msgid ""
"<pre>\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:39
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:46
msgid "Note: you may need to restart the kernel to use updated packages."
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:57
msgid "We first load a model"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid "model = pybamm.lithium_ion.DFN()"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:78
msgid ""
"Next we use the helper function ``insert_reference_electrode`` to insert a "
"reference electrode into the model. This function takes the position of the "
"reference electrode as an optional argument. If no position is given, the "
"reference electrode is inserted at the midpoint of the separator. The helper "
"function adds the new variables \"Reference electrode potential [V]\", "
"\"Negative electrode 3E potential [V]\" and \"Positive electrode 3E "
"potential [V]\" to the model."
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:80
msgid ""
"In this example we will explicitly pass a position to show how it is done"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid ""
"L_n = model.param.n.L  # Negative electrode thickness [m]\n"
"L_s = model.param.s.L  # Separator thickness [m]\n"
"L_ref = L_n + L_s / 2  # Reference electrode position [m]\n"
"\n"
"model.insert_reference_electrode(L_ref)"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:105
msgid "Next we can set up a simulation and solve the model as usual"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:-1
msgid ""
"sim = pybamm.Simulation(model)\n"
"sim.solve([0, 3600])"
msgstr ""

#: ../../../source/examples/notebooks/models/simulate-3E-cell.ipynb:128
msgid ""
"<pre>\n"
"&lt;pybamm.solvers.solution.Solution at 0x169dc5950&gt;\n"
"</pre>"
msgstr ""

