#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:179
msgid "Solve for electrode SOH variables"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:190
msgid ""
"Given a total amount of cyclable lithium capacity, :math:`Q_{Li}`, electrode "
"capacities, :math:`Q_n` and :math:`Q_p`, and voltage limits, :math:`V_{min}` "
"and :math:`V_{max}`, we can solve for the min and max electrode SOCs, :math:"
"`x_0`, :math:`x_{100}`, :math:`y_0`, and :math:`y_{100}`, and the cell "
"capacity, :math:`C`, using the algorithm adapted from Mohtat et al [1]. "
"First, we find :math:`x_{100}` and :math:`y_{100}` using"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:192
msgid ""
"Q_{Li} = y_{100}Q_p + x_{100}Q_n,\n"
"\\\\\n"
"V_{max} = U_p(y_{100}) - U_n(x_{100})."
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:199
msgid ""
"Note that Mohtat et al use :math:`n_{Li} = \\frac{3600 Q_{Li}}{F}` instead. "
"Then, we find :math:`Q` using"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:201
msgid ""
"V_{min} = U_p(y_{0}) - U_n(x_{0})\n"
"= U_p\\left(y_{100} + \\frac{Q}{Q_p}\\right) - U_n\\left(x_{100} - \\frac{Q}"
"{Q_n}\\right)"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:207
msgid "Finally, :math:`x_0` and :math:`y_0` are simply defined as"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:209
msgid ""
"x_0 = x_{100} - \\frac{Q}{Q_n},\n"
"\\\\\n"
"y_0 = y_{100} + \\frac{Q}{Q_p}."
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:216
msgid "We implement this in PyBaMM as an algebraic model."
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:-1
msgid "[28]:"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:-1
msgid ""
"param = pybamm.LithiumIonParameters()\n"
"\n"
"Vmin = 2.8\n"
"Vmax = 4.2\n"
"Q_n = parameter_values.evaluate(param.n.Q_init)\n"
"Q_p = parameter_values.evaluate(param.p.Q_init)\n"
"Q_Li = parameter_values.evaluate(param.Q_Li_particles_init)\n"
"\n"
"U_n = param.n.prim.U\n"
"U_p = param.p.prim.U\n"
"T_ref = param.T_ref"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:-1
msgid "[29]:"
msgstr ""

#: ../../../source/examples/notebooks/models/electrode-state-of-health.ipynb:-1
msgid ""
"# First we solve for x_100 and y_100\n"
"\n"
"model = pybamm.BaseModel()\n"
"\n"
"x_100 = pybamm.Variable(\"x_100\")\n"
"y_100 = (Q_Li - x_100 * Q_n) / Q_p\n"
"\n"
"y_100_min = 1e-10\n"
"\n"
"x_100_upper_limit = (Q_Li - y_100_min * Q_p) / Q_n\n"
"\n"
"model.algebraic = {x_100: U_p(y_100, T_ref) - U_n(x_100, T_ref) - Vmax}\n"
"\n"
"model.initial_conditions = {x_100: x_100_upper_limit}\n"
"\n"
"model.variables = {\"x_100\": x_100, \"y_100\": y_100}\n"
"\n"
"sim = pybamm.Simulation(model, parameter_values=parameter_values)\n"
"sol = sim.solve([0])\n"
"\n"
"x_100 = sol[\"x_100\"].data[0]\n"
"y_100 = sol[\"y_100\"].data[0]\n"
"\n"
"for var in [\"x_100\", \"y_100\"]:\n"
"    print(var, \":\", sol[var].data[0])\n"
"\n"
"# Based on the calculated values for x_100 and y_100 we solve for x_0\n"
"model = pybamm.BaseModel()\n"
"\n"
"x_0 = pybamm.Variable(\"x_0\")\n"
"Q = Q_n * (x_100 - x_0)\n"
"y_0 = y_100 + Q / Q_p\n"
"\n"
"model.algebraic = {x_0: U_p(y_0, T_ref) - U_n(x_0, T_ref) - Vmin}\n"
"model.initial_conditions = {x_0: 0.1}\n"
"\n"
"model.variables = {\n"
"    \"Q\": Q,\n"
"    \"x_0\": x_0,\n"
"    \"y_0\": y_0,\n"
"}\n"
"\n"
"sim = pybamm.Simulation(model, parameter_values=parameter_values)\n"
"sol = sim.solve([0])\n"
"\n"
"\n"
"for var in [\"Q\", \"x_0\", \"y_0\"]:\n"
"    print(var, \":\", sol[var].data[0])"
msgstr ""

