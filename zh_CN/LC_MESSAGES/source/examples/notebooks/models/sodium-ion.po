#: ../../../source/examples/notebooks/models/sodium-ion.ipynb:171
msgid ""
"We can now perform a manual plot of voltage versus capacity, to compare the "
"results with the COMSOL example."
msgstr ""

#: ../../../source/examples/notebooks/models/sodium-ion.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/models/sodium-ion.ipynb:-1
msgid ""
"import matplotlib.pyplot as plt\n"
"\n"
"for solution, C_rate in zip(solutions, C_rates, strict=False):\n"
"    capacity = [i * 1000 for i in solution[\"Discharge capacity [A.h]\"]."
"entries]\n"
"    voltage = solution[\"Voltage [V]\"].entries\n"
"    plt.plot(capacity, voltage, label=f\"{(12 * C_rate)} A.m-2\")\n"
"\n"
"plt.xlabel(\"Discharge Capacity [mA.h]\")\n"
"plt.ylabel(\"Voltage [V]\");"
msgstr ""

