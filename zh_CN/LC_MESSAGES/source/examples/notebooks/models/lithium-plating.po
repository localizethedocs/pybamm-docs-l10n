#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:50
msgid "Note: you may need to restart the kernel to use updated packages."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:61
msgid ""
"The Doyle-Fuller-Newman model [3] is upgraded with three different lithium "
"plating models. Model 1 contains the reversible lithium plating model of "
"O'Kane et al. [5]. Model 2 contains the same model but with the lithium "
"stripping capability removed, making the plating irreversible. Model 3 "
"contains the updated partially reversible plating of O'Kane et al. [6]. The "
"parameters are taken from Chen et al.'s investigation [2] of an LG M50 cell."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"# choose models\n"
"plating_options = [\"reversible\", \"irreversible\", \"partially "
"reversible\"]\n"
"models = {\n"
"    option: pybamm.lithium_ion.DFN(options={\"lithium plating\": option}, "
"name=option)\n"
"    for option in plating_options\n"
"}\n"
"\n"
"# pick parameters\n"
"parameter_values = pybamm.ParameterValues(\"OKane2022\")\n"
"parameter_values.update({\"Ambient temperature [K]\": 268.15})\n"
"parameter_values.update({\"Upper voltage cut-off [V]\": 4.21})\n"
"# parameter_values.update({\"Lithium plating kinetic rate constant [m."
"s-1]\": 1E-9})\n"
"parameter_values.update({\"Lithium plating transfer coefficient\": 0.5})\n"
"parameter_values.update({\"Dead lithium decay constant [s-1]\": 1e-4})"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:95
msgid ""
"A series of simple fast charging experiments based on those of Ren et al. "
"[7] is defined here. We first initialise the model at 0% SoC by performing a "
"C/20 discharge (see more details on how to initialise a model from a "
"simulation in `this notebook <../initialize-model-with-solution.ipynb>`__)."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"# specify experiments\n"
"pybamm.citations.register(\"Ren2018\")\n"
"\n"
"s = pybamm.step.string\n"
"experiment_discharge = pybamm.Experiment(\n"
"    [\n"
"        (\n"
"            s(\"Discharge at C/20 until 2.5 V\"),\n"
"            s(\"Rest for 1 hour\"),\n"
"        ),\n"
"    ]\n"
")\n"
"\n"
"sims_discharge = []\n"
"for model in models.values():\n"
"    # we need to adjust the tolerances to get a good solution for the "
"partially reversible case\n"
"    solver = pybamm.IDAKLUSolver(atol=1e-5, rtol=1e-5)\n"
"    sim_discharge = pybamm.Simulation(\n"
"        model,\n"
"        parameter_values=parameter_values,\n"
"        experiment=experiment_discharge,\n"
"        solver=solver,\n"
"    )\n"
"    sol_discharge = sim_discharge.solve(calc_esoh=False)\n"
"    model.set_initial_conditions_from(sol_discharge, inplace=True)\n"
"    sims_discharge.append(sim_discharge)"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:141
msgid ""
"And we can now define the different experiments to charge at different C-"
"rates."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"C_rates = [\"2C\", \"1C\", \"C/2\", \"C/4\", \"C/8\"]\n"
"experiments = {}\n"
"for C_rate in C_rates:\n"
"    experiments[C_rate] = pybamm.Experiment(\n"
"        [\n"
"            (\n"
"                f\"Charge at {C_rate} until 4.2 V\",\n"
"                \"Hold at 4.2 V until C/20\",\n"
"                \"Rest for 1 hour\",\n"
"            )\n"
"        ]\n"
"    )"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:173
msgid "Solve the reversible plating model first."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"def define_and_solve_sims(model, experiments, parameter_values):\n"
"    sims = {}\n"
"    for C_rate, experiment in experiments.items():\n"
"        sim = pybamm.Simulation(\n"
"            model, experiment=experiment, parameter_values=parameter_values\n"
"        )\n"
"        sim.solve(calc_esoh=False)\n"
"        sims[C_rate] = sim\n"
"\n"
"    return sims\n"
"\n"
"\n"
"sims_reversible = define_and_solve_sims(\n"
"    models[\"partially reversible\"], experiments, parameter_values\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"colors = [\"tab:purple\", \"tab:cyan\", \"tab:red\", \"tab:green\", \"tab:"
"blue\"]\n"
"linestyles = [\"dashed\", \"dotted\", \"solid\"]\n"
"\n"
"param = models[\"reversible\"].param\n"
"A = parameter_values.evaluate(param.L_y * param.L_z)\n"
"F = parameter_values.evaluate(param.F)\n"
"L_n = parameter_values.evaluate(param.n.L)\n"
"\n"
"currents = [\n"
"    \"X-averaged negative electrode volumetric interfacial current density "
"[A.m-3]\",\n"
"    \"X-averaged negative electrode lithium plating volumetric interfacial "
"current density [A.m-3]\",\n"
"    \"Sum of x-averaged negative electrode volumetric interfacial current "
"densities [A.m-3]\",\n"
"]\n"
"\n"
"\n"
"def plot(sims):\n"
"    import matplotlib.pyplot as plt\n"
"\n"
"    fig, axs = plt.subplots(2, 2, figsize=(13, 9))\n"
"    for (C_rate, sim), color in zip(sims.items(), colors, strict=False):\n"
"        # Isolate final equilibration phase\n"
"        sol = sim.solution.cycles[0].steps[2]\n"
"\n"
"        # Voltage vs time\n"
"        t = sol[\"Time [min]\"].entries\n"
"        t = t - t[0]\n"
"        V = sol[\"Voltage [V]\"].entries\n"
"        axs[0, 0].plot(t, V, color=color, linestyle=\"solid\", "
"label=C_rate)\n"
"\n"
"        # Currents\n"
"        for current, ls in zip(currents, linestyles, strict=False):\n"
"            j = sol[current].entries\n"
"            axs[0, 1].plot(t, j, color=color, linestyle=ls)\n"
"\n"
"        # Plated lithium capacity\n"
"        Q_Li = sol[\"Loss of capacity to negative lithium plating [A.h]\"]."
"entries\n"
"        axs[1, 0].plot(t, Q_Li, color=color, linestyle=\"solid\")\n"
"\n"
"        # Capacity vs time\n"
"        Q_main = (\n"
"            sol[\"Negative electrode volume-averaged concentration [mol."
"m-3]\"].entries\n"
"            * F\n"
"            * A\n"
"            * L_n\n"
"            / 3600\n"
"        )\n"
"        axs[1, 1].plot(t, Q_main, color=color, linestyle=\"solid\")\n"
"\n"
"    axs[0, 0].legend()\n"
"    axs[0, 0].set_ylabel(\"Voltage [V]\")\n"
"    axs[0, 1].set_ylabel(\"Volumetric interfacial current density [A."
"m-3]\")\n"
"    axs[0, 1].legend((\"Deintercalation current\", \"Stripping current\", "
"\"Total current\"))\n"
"    axs[1, 0].set_ylabel(\"Plated lithium capacity [A.h]\")\n"
"    axs[1, 1].set_ylabel(\"Intercalated lithium capacity [A.h]\")\n"
"\n"
"    for ax in axs.flat:\n"
"        ax.set_xlabel(\"Time [minutes]\")\n"
"\n"
"    fig.tight_layout()\n"
"\n"
"    return fig, axs\n"
"\n"
"\n"
"plot(sims_reversible);"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:289
msgid ""
"The results show both similarities and differences with those of Ren et al. "
"[7]. Notably, unlike Ren et al., this model uses equations [5] that result "
"in a small but finite amount of plated lithium being present in the steady "
"state."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:300
msgid "Now solve the irreversible plating model and see how it compares."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[7]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"sims_irreversible = define_and_solve_sims(\n"
"    models[\"irreversible\"], experiments, parameter_values\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "plot(sims_irreversible);"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:341
msgid ""
"Unlike in the reversible case, there is no steady state and the capacity "
"degrades quickly. The lithium inventory decreases by around 40 mAh in just "
"an hour, which is unrealistic. The low temperature fast charge simulations "
"are run one more time, with the partially reversible plating model."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[9]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"sims_partially_reversible = define_and_solve_sims(\n"
"    models[\"partially reversible\"], experiments, parameter_values\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[10]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "plot(sims_partially_reversible);"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:382
msgid ""
"The partially reversible plating model has features of both the reversible "
"and irreversible models, which is reflected in the results. The plated "
"lithium capacity decreases with time as lithium is reversibly stripped, but "
"the final plated lithium capacity now depends on charge rate, indicating "
"that some lithium was irreversibly plated during charge."
msgstr ""

