#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:9
msgid "Modelling lithium plating in PyBaMM"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:11
msgid ""
"This notebook shows how PyBaMM [8] can be used to model both reversible and "
"irreversible lithium plating."
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import os\n"
"\n"
"import pybamm\n"
"\n"
"os.chdir(pybamm.__path__[0] + \"/..\")"
msgstr ""

#: ../../../source/examples/notebooks/models/lithium-plating.ipynb:37
msgid ""
