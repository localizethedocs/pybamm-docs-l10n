msgid "\"Full\" model"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:83
msgid "Electrolyte Concentration"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:85
msgid ""
"\\frac{\\partial }{\\partial t}\\left(\\epsilon c\\right) = -"
"\\frac{\\partial N}{\\partial x} + sj, \\\\\n"
"N = -\\frac{\\epsilon^b  D(c)}{\\mathcal{C}_\\text{e}}  \\frac{\\partial c}"
"{\\partial x}\\\\\n"
"N\\big|_{x=0}= N\\big|_{x=1}=0, \\\\\n"
"c\\big|_{t=0} = 1"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:94
msgid "Porosity"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:96
msgid ""
"\\frac{\\partial \\epsilon}{\\partial t} = -\\beta^\\text{surf}j, \\\\\n"
"\\epsilon\\big|_{t=0} = \\epsilon^0"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:103
msgid "Electrolyte Current"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:105
msgid ""
"\\frac{\\partial i_{\\text{e}}}{\\partial x} = j, \\\\\n"
"\\mathcal{C}_\\text{e} i_{\\text{e}} = \\epsilon_k^b \\kappa(c)\n"
"    \\left( \\chi \\frac{\\partial}{\\partial x}\\log(c)\n"
"    - \\frac{\\partial\\phi_{\\text{e}}}{\\partial x}\\right)\\\\\n"
"i_{\\text{e}}\\big|_{x=0}= i_{\\text{e}}\\big|_{x=1}=0,"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:115
msgid "Electrode Current"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:117
msgid ""
"\\frac{\\partial i_{\\text{s}}}{\\partial x} = -j,\\\\\n"
"i_{\\text{s}} = -\\sigma\\frac{\\partial\\phi_{\\text{s}}}{\\partial x},\\"
"\\\n"
"\\phi_{\\text{s}}\\big|_{x=0}\n"
"    = i_{\\text{s}}\\big|_{x=l_\\text{n}}\n"
"    = i_{\\text{s}}\\big|_{x=1-l_\\text{p}} = 0, \\\\\n"
"i_{\\text{s}}\\big|_{x=1}=\\mathcal{I},"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:128
msgid "Interfacial current density"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:130
msgid ""
"j = \\begin{cases}\n"
"    2j_0(c) \\sinh\\left(\\eta\\right), \\quad &0 < x < l_\\text{n} \\\\\n"
"    0, \\quad &l_\\text{n} < x < 1-l_\\text{p} \\\\\n"
"    2j_0(c) \\sinh\\left(\\eta\\right), \\quad &1-l_\\text{p} < x < 1\n"
"\\end{cases}\n"
"\\\\\n"
"\\eta = \\phi_{\\text{s}} - \\phi_\\text{e} - U(c),"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:141
msgid "This model is implemented in PyBaMM as the ``Full`` model"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "full = pybamm.lead_acid.Full()"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:163
msgid "\"Leading-order\" model"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:165
msgid ""
"\\frac{\\mathrm{d} }{\\mathrm{d} t}\\left(\\epsilon c\\right) = (s_\\text{n} "
"- s_\\text{p})\\mathrm{I}, \\\\\n"
"\\frac{\\mathrm{d} \\epsilon}{\\mathrm{d} t} = -\\beta^\\text{surf}j, \\\\\n"
"j = \\begin{cases}\n"
"    \\mathrm{I}/l_\\text{n}, \\quad &0 < x < l_\\text{n} \\\\\n"
"    0, \\quad &l_\\text{n} < x < 1-l_\\text{p} \\\\\n"
"    -\\mathrm{I}/l_\\text{p}, \\quad &1-l_\\text{p} < x < 1\n"
"\\end{cases} \\\\\n"
"\\phi_\\text{e} = -U_\\text{n}(c) + \\sinh^{-1}\\left(\\frac{\\mathrm{I}}"
"{2l_\\text{n}j_{0\\text{n}}(c)}\\right) \\\\\n"
"V = -\\phi_\\text{e} + U_\\text{p}(c) - \\sinh^{-1}\\left(\\frac{\\mathrm{I}}"
"{2l_\\text{p}j_{0\\text{p}}(c)}\\right) \\\\"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:178
msgid ""
"This model is implemented in PyBaMM as ``LOQS`` (leading-order quasi-static)"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "loqs = pybamm.lead_acid.LOQS()"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:200
msgid "Solving the models"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:211
msgid ""
"We load process parameters for each model, using the same set of (default) "
"parameters for all. In anticipation of changing the current later, we make "
"current an input parameter"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid ""
"# load models\n"
"models = [loqs, full]\n"
"\n"
"# process parameters\n"
"param = models[0].default_parameter_values\n"
"param[\"Current function [A]\"] = \"[input]\"\n"
"for model in models:\n"
"    param.process_model(model)"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:239
msgid "Then, we discretise the models, using the default settings"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid ""
"for model in models:\n"
"    # load and process default geometry\n"
"    geometry = model.default_geometry\n"
"    param.process_geometry(geometry)\n"
"\n"
"    # discretise using default settings\n"
"    mesh = pybamm.Mesh(geometry, model.default_submesh_types, model."
"default_var_pts)\n"
"    disc = pybamm.Discretisation(mesh, model.default_spatial_methods)\n"
"    disc.process_model(model)"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:268
msgid "Finally, we solve each model using CasADi's solver and a current of 1A"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/models/lead-acid.ipynb:-1
msgid ""
"timer = pybamm.Timer()\n"
"solutions = {}\n"
"t_eval = np.linspace(0, 3600 * 17, 100)  # time in seconds\n"
"for model in models:\n"
"    solver = pybamm.CasadiSolver()\n"
"    timer.reset()\n"
"    solution = solver.solve(model, t_eval, inputs={\"Current function [A]\": "
"1})\n"
"    print(f\"Solved the {model.name} in {timer.time()}\")\n"
"    solutions[model] = solution"
msgstr ""

