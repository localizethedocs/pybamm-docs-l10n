#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:83
msgid "Solve a model with a drive cycle"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:94
msgid "Load model"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[20]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "model = pybamm.lithium_ion.DFN()"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:115
msgid "Set up drive cycle"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[21]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid ""
"# import drive cycle from file\n"
"data_loader = pybamm.DataLoader()\n"
"drive_cycle = pd.read_csv(\n"
"    f\"{data_loader.get_data('US06.csv')}\", comment=\"#\", header=None\n"
").to_numpy()\n"
"# create interpolant\n"
"param = model.default_parameter_values\n"
"current_interpolant = pybamm.Interpolant(drive_cycle[:, 0], drive_cycle[:, "
"1], pybamm.t)\n"
"# set drive cycle\n"
"param[\"Current function [A]\"] = current_interpolant"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:145
msgid "Create and run simulation with the updated parameters"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[22]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid ""
"sim_US06_1 = pybamm.Simulation(model, parameter_values=param)\n"
"sol_US06_1 = sim_US06_1.solve()"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:168
msgid "Update initial conditions based on a solution and solve again"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:179
msgid ""
"Starting with an initial SOC of 0%, pre-charge with CCCV, update the initial "
"conditions, and solve again with the US06 drive cycle"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[23]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid ""
"experiment = pybamm.Experiment(\n"
"    [\"Charge at 1 A until 3.9 V\", \"Hold at 3.9 V until 50 mA\"],\n"
")\n"
"sim_cccv = pybamm.Simulation(model, experiment=experiment)\n"
"sol_cccv = sim_cccv.solve(initial_soc=0)\n"
"\n"
"# MODEL RE-INITIALIZATION: "
"#############################################################\n"
"# Now initialize the model with the solution of the charge, and then "
"discharge with\n"
"# the US06 drive cycle\n"
"# We could also do this inplace by setting inplace to True, which modifies "
"the original\n"
"# model in place\n"
"new_model = model.set_initial_conditions_from(sol_cccv, inplace=False)\n"
"########################################################################################\n"
"\n"
"sim_US06_2 = pybamm.Simulation(new_model, parameter_values=param)\n"
"sol_US06_2 = sim_US06_2.solve()"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:215
msgid ""
"Plot both solutions, we can clearly see the difference now that initial "
"conditions have been updated"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[24]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid ""
"pybamm.dynamic_plot(\n"
"    [sol_US06_1, sol_US06_2], labels=[\"Default initial conditions\", "
"\"Fully charged\"]\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:240
msgid ""
