#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:301
msgid "Initialize using a different model"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:312
msgid ""
"We can also initialize the model using the solution of a different model"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[25]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid ""
"spm = pybamm.lithium_ion.SPM()\n"
"sim_spm_cccv = pybamm.Simulation(spm, experiment=experiment)\n"
"sol_spm_cccv = sim_spm_cccv.solve(initial_soc=0)\n"
"\n"
"# MODEL RE-INITIALIZATION: "
"#############################################################\n"
"# Now initialize the model with the solution of the charge, and then "
"discharge with\n"
"# the US06 drive cycle\n"
"# We could also do this inplace by setting inplace to True, which modifies "
"the original\n"
"# model in place\n"
"new_dfn = model.set_initial_conditions_from(sol_spm_cccv, inplace=False)\n"
"########################################################################################\n"
"\n"
"sim_US06_3 = pybamm.Simulation(new_dfn, parameter_values=param)\n"
"sol_US06_3 = sim_US06_3.solve()"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:346
msgid ""
"Now the model initialized by the DFN and the model initialized by the SPM "
"give the same solution"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid "[26]:"
msgstr ""

#: ../../../source/examples/notebooks/initialize-model-with-solution.ipynb:-1
msgid ""
"pybamm.dynamic_plot(\n"
"    [sol_US06_1, sol_US06_2, sol_US06_3],\n"
"    labels=[\n"
"        \"Default initial conditions\",\n"
"        \"Fully charged (from DFN)\",\n"
"        \"Fully charged (from SPM)\",\n"
"    ],\n"
")"
msgstr ""

