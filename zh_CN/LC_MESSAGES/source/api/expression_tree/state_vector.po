msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/state_vector.py:docstring
#: of pybamm.expression_tree.state_vector.StateVector:11
#: pybamm.expression_tree.state_vector.StateVectorDot:11
msgid ""
"A dictionary equivalent to {'primary': domain, auxiliary_domains}. Either "
"'domain' and 'auxiliary_domains', or just 'domains', should be provided (not "
"both). In future, the 'domain' and 'auxiliary_domains' arguments may be "
"deprecated."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/state_vector.py:docstring
#: of pybamm.expression_tree.state_vector.StateVector:16
#: pybamm.expression_tree.state_vector.StateVectorDot:16
msgid ""
"List of boolean arrays representing slices. Default is None, in which case "
"the evaluation_array is computed from y_slices."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/state_vector.py:docstring
