#: of pybamm.expression_tree.unary_operators.Integral:6
msgid ""
"where :math:`u\\in\\text{domain}` is a spatial variable, :math:`u_{min}` "
"and :math:`u_{max}` are the values of :math:`u` at the left-hand and right-"
"hand boundaries of the domain respectively, and :math:`dq` is given by,"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.Integral:9
msgid ":math:`dq=du` for cartesian coordinates,"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.Integral:11
msgid ":math:`dq=2\\pi udu` for cylindrical coordinates,"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.Integral:13
msgid ":math:`dq=4\\pi u^2 du` for spherical coordinates."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.BoundaryIntegral:10
#: pybamm.expression_tree.unary_operators.IndefiniteIntegral:9
#: pybamm.expression_tree.unary_operators.Integral:15
msgid "The function to be integrated (will become self.children[0])"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.IndefiniteIntegral:11
#: pybamm.expression_tree.unary_operators.Integral:17
msgid "The variable over which to integrate"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.IndefiniteIntegral:1
msgid ""
"A node in the expression tree representing an indefinite integral operator."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.IndefiniteIntegral:3
msgid ""
"I = \\int_{x_    ext{min}}^{x}\\!f(u)\\,du\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.IndefiniteIntegral:6
msgid ""
"where :math:`u\\in\\text{domain}` which can represent either a spatial or "
"temporal variable."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.IndefiniteIntegral:14
