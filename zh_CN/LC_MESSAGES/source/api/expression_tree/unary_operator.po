#: of pybamm.expression_tree.unary_operators.DeltaFunction.evaluate_for_shape:1
msgid "See :meth:`pybamm.Symbol.evaluate_for_shape_using_domain()`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
