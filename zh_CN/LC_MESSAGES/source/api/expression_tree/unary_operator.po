"spatial method. Can be \"constant\", \"linear\" or \"quadratic\"."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.BoundaryGradient:12
#: pybamm.expression_tree.unary_operators.BoundaryValue:12
msgid ""
"**Extends:** :class:`pybamm.expression_tree.unary_operators.BoundaryOperator`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.BoundaryGradient:1
msgid ""
"A node in the expression tree which gets the boundary flux of a variable on "
"its primary domain."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.BoundaryGradient:4
msgid "The variable whose boundary flux to take"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.BoundaryGradient:6
msgid "Which side to take the boundary flux on (\"left\" or \"right\")"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.EvaluateAt:1
msgid ""
"A node in the expression tree which evaluates a symbol at a given position "
"in space in its primary domain. Currently this is only implemented for 1D "
"primary domains."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.EvaluateAt:4
msgid "The variable to evaluate"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.EvaluateAt:6
msgid ""
"The position in space on the symbol's primary domain at which to evaluate "
"the symbol."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.UpwindDownwind:1
msgid ""
"A node in the expression tree representing an upwinding or downwinding "
"operator. Usually to be used for better stability in convection-dominated "
"equations."
msgstr ""

