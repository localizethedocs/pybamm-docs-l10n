#: of pybamm.expression_tree.unary_operators.Upwind:1
msgid ""
"Upwinding operator. To be used if flow velocity is positive (left to right)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/unary_operators.py:docstring
#: of pybamm.expression_tree.unary_operators.Downwind:3
