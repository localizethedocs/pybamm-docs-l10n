#: ../../../source/api/meshes/one_dimensional_submeshes.rst:2
msgid "1D Sub Meshes"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.SubMesh1D:1
msgid ""
"1D submesh class. Contains the position of the nodes, the number of mesh "
"points, and (optionally) information about the tab locations."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:0
#: pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:0
#: pybamm.meshes.one_dimensional_submeshes.SubMesh1D:0
#: pybamm.meshes.one_dimensional_submeshes.Uniform1DSubMesh:0
#: pybamm.meshes.one_dimensional_submeshes.UserSupplied1DSubMesh:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.SubMesh1D:5
msgid ""
"An array containing the points corresponding to the edges of the submesh"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.SubMesh1D:7
msgid "The coordinate system of the submesh"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:19
#: pybamm.meshes.one_dimensional_submeshes.SubMesh1D:9
msgid ""
"A dictionary that contains information about the size and location of the "
"tabs"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.SubMesh1D:13
msgid "**Extends:** :class:`pybamm.meshes.meshes.SubMesh`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Uniform1DSubMesh:1
msgid "A class to generate a uniform submesh on a 1D domain"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:13
#: pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:34
#: pybamm.meshes.one_dimensional_submeshes.Uniform1DSubMesh:3
#: pybamm.meshes.one_dimensional_submeshes.UserSupplied1DSubMesh:4
msgid "A dictionary that contains the limits of the spatial variables"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:15
#: pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:36
#: pybamm.meshes.one_dimensional_submeshes.Uniform1DSubMesh:5
#: pybamm.meshes.one_dimensional_submeshes.UserSupplied1DSubMesh:6
msgid ""
"A dictionary that contains the number of points to be used on each spatial "
"variable. Note: the number of nodes (located at the cell centres) is npts, "
"and the number of edges is npts+1."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:23
#: pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:49
#: pybamm.meshes.one_dimensional_submeshes.Uniform1DSubMesh:10
#: pybamm.meshes.one_dimensional_submeshes.UserSupplied1DSubMesh:13
msgid "**Extends:** :class:`pybamm.meshes.one_dimensional_submeshes.SubMesh1D`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:1
msgid ""
"A class to generate a submesh on a 1D domain in which the points are "
"clustered close to one or both of boundaries using an exponential formula on "
"the interval [a,b]."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:5
msgid "If side is \"left\", the gridpoints are given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:7
msgid ""
"x_{k} = (b-a) +\n"
"\\frac{\\mathrm{e}^{\\alpha k / N} - 1}{\\mathrm{e}^{\\alpha} - 1} + a,\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:11
msgid "for k = 1, ..., N, where N is the number of nodes."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:13
msgid "Is side is \"right\", the gridpoints are given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:15
msgid ""
"x_{k} = (b-a) +\n"
"\\frac{\\mathrm{e}^{-\\alpha k / N} - 1}{\\mathrm{e}^{-\\alpha} - 1} + a,\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:19
msgid "for k = 1, ..., N."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:21
msgid ""
"If side is \"symmetric\", the first half of the interval is meshed using the "
"gridpoints"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:24
msgid ""
"x_{k} = (b/2-a) +\n"
"\\frac{\\mathrm{e}^{\\alpha k / N} - 1}{\\mathrm{e}^{\\alpha} - 1} + a,\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:28
msgid ""
"for k = 1, ..., N. The grid spacing is then reflected to contruct the grid "
"on the full interval [a,b]."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:31
msgid ""
"In the above, alpha is a stretching factor. As the number of gridpoints "
"tends to infinity, the ratio of the largest and smallest grid cells tends to "
"exp(alpha)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:40
msgid ""
"Whether the points are clustered near to the left or right boundary, or both "
"boundaries. Can be \"left\", \"right\" or \"symmetric\". Default is "
"\"symmetric\""
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Exponential1DSubMesh:44
msgid ""
"The factor (alpha) which appears in the exponential. If side is "
"\"symmetric\" then the default stretch is 1.15. If side is \"left\" or "
"\"right\" then the default stretch is 2.3."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:1
msgid ""
"A class to generate a submesh on a 1D domain using Chebyshev nodes on the "
"interval (a, b), given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:4
msgid ""
"x_{k} = \\frac{1}{2}(a+b) + \\frac{1}{2}(b-a) \\cos(\\frac{2k-1}{2N}\\pi),\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:7
msgid ""
"for k = 1, ..., N, where N is the number of nodes. Note: this mesh then "
"appends the boundary edges, so that the mesh edges are given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.Chebyshev1DSubMesh:10
msgid ""
"a < x_{1} < ... < x_{N} < b.\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.UserSupplied1DSubMesh:1
msgid ""
"A class to generate a submesh on a 1D domain from a user supplied array of "
"edges."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/one_dimensional_submeshes.py:docstring
#: of pybamm.meshes.one_dimensional_submeshes.UserSupplied1DSubMesh:10
msgid "The array of points which correspond to the edges of the mesh."
msgstr ""
