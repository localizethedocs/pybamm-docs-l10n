#: ../../../source/api/experiment/experiment_steps.rst:23
msgid "Custom steps"
msgstr ""

#: ../../../source/api/experiment/experiment_steps.rst:25
msgid "Custom steps can be defined using either explicit or implicit control:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/experiment/step/steps.py:docstring
#: of pybamm.experiment.step.steps.CustomStepExplicit:1
msgid ""
"Custom step class where the current value is explicitly given as a function "
"of other variables. When using this class, the user must be careful not to "
"create an expression that depends on the current itself, as this will lead "
"to a circular dependency. For example, in some models, the voltage is an "
"explicit function of the current, so the user should not create a step that "
"depends on the voltage. An expression that works for one model may not work "
"for another."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/experiment/step/steps.py:docstring
#: of pybamm.experiment.step.steps.CustomStepExplicit:8
