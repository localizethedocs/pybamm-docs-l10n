#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/experiment/step/base_step.py:docstring
#: of pybamm.experiment.step.base_step.BaseStep:1
msgid ""
"Class representing one step in an experiment. All experiment steps are "
"functions that return an instance of this class. This class is not intended "
"to be used directly, but can be subtyped to create a custom experiment step."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/experiment/step/base_step.py:docstring
#: of pybamm.experiment.step.base_step.BaseStep:6
