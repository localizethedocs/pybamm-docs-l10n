msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/idaklu_solver.py:docstring
#: of pybamm.solvers.idaklu_solver.IDAKLUSolver.reduce_solution:3
msgid ""
"The multiplier M controls the total error budget relative to the solver's "
"own WRMS tolerance.  The knot reducer is allowed an additional WRMS error of "
"(M-1), so the total error satisfies ``||e_total||_WRMS <= M``.  M = 2 "
"(default) means the reduced solution may have up to 2x the solver's local "
"error."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/idaklu_solver.py:docstring
#: of pybamm.solvers.idaklu_solver.IDAKLUSolver.reduce_solution:9
