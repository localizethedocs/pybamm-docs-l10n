"The solution to reduce. Must have hermite interpolation data (all_yps is not "
"None)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/idaklu_solver.py:docstring
#: of pybamm.solvers.idaklu_solver.IDAKLUSolver.reduce_solution:12
msgid ""
"Total error multiplier (>= 1.0, default 2.0). The knot reducer's WRMS "
"threshold is N * (M-1)^2. Larger values allow more aggressive reduction."
msgstr ""

