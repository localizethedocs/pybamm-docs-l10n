#: ../../../source/api/solvers/casadi_solver.rst:2
msgid "Casadi Solver"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:1
msgid "Solve a discretised model, using CasADi."
msgstr ""

#: ../../../source/api/solvers/casadi_solver.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:3
msgid ""
"How to solve the model (default is \"safe\"):      - \"fast\": perform "
"direct integration, without accounting for events.             Recommended "
"when simulating a drive cycle or other simulation where             no "
"events should be triggered.     - \"fast with events\": perform direct "
"integration of the whole timespan,             then go back and check where "
"events were crossed. Experimental only.     - \"safe\": perform step-and-"
"check integration in global steps of size             dt_max, checking "
"whether events have been triggered. Recommended for             simulations "
"of a full charge or discharge.     - \"safe without grid\": perform step-and-"
"check integration step-by-step.             Takes more steps than \"safe\" "
"mode, but doesn't require creating the grid             each time, so may be "
"faster. Experimental only."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:4
msgid "How to solve the model (default is \"safe\"):"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:6
msgid ""
"\"fast\": perform direct integration, without accounting for "
"events.             Recommended when simulating a drive cycle or other "
"simulation where             no events should be triggered."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:7
msgid ""
"\"fast with events\": perform direct integration of the whole "
"timespan,             then go back and check where events were crossed. "
"Experimental only."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:8
msgid ""
"\"safe\": perform step-and-check integration in global steps of "
"size             dt_max, checking whether events have been triggered. "
"Recommended for             simulations of a full charge or discharge."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:9
msgid ""
"\"safe without grid\": perform step-and-check integration step-by-"
"step.             Takes more steps than \"safe\" mode, but doesn't require "
"creating the grid             each time, so may be faster. Experimental only."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:11
msgid "The relative tolerance for the solver (default is 1e-6)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:13
msgid "The absolute tolerance for the solver (default is 1e-6)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:15
msgid ""
"The method to use to find initial conditions (for DAE solvers). Default is "
"\"nonlinear_solver\", which uses a custom Newton solver for consistent "
"initial conditions (recommended). If \"casadi\", the solver uses casadi's "
"Newton rootfinding algorithm as a fallback. Otherwise, the solver uses "
"'scipy.optimize.root' with method specified by 'root_method' (e.g. \"lm\", "
"\"hybr\", ...)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:22
msgid "The tolerance for root-finding. Default is 1e-6."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:24
msgid ""
"The maximum number of times step size can be decreased before an error is "
"raised. Default is 5."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:27
msgid ""
"The maximum global step size (in seconds) used in \"safe\" mode. If None the "
"default value is 600 seconds."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:30
msgid ""
"The tolerance to assert whether extrapolation occurs or not. Default is 0."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:32
msgid ""
"What to do if the solver is extrapolating. Options are \"warn\", \"error\", "
"or \"ignore\". Default is \"error\"."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:35
msgid ""
"Any options to pass to the CasADi integrator when creating the integrator. "
"Please consult `CasADi documentation <https://web.casadi.org/python-api/"
"#integrator>`_ for details. Some useful options:  - \"max_num_steps\": "
"Maximum number of integrator steps - \"print_stats\": Print out statistics "
"after integration"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:35
msgid ""
"Any options to pass to the CasADi integrator when creating the integrator. "
"Please consult `CasADi documentation <https://web.casadi.org/python-api/"
"#integrator>`_ for details. Some useful options:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:39
msgid "\"max_num_steps\": Maximum number of integrator steps"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:40
msgid "\"print_stats\": Print out statistics after integration"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:42
msgid ""
"Any options to pass to the CasADi integrator when calling the integrator. "
"Please consult `CasADi documentation <https://web.casadi.org/python-api/"
"#integrator>`_ for details."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:46
msgid ""
"Whether to return a Solution object if the solver fails to reach the end of "
"the simulation, but managed to take some successful steps. Default is False."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:49
msgid ""
"Whether to perturb algebraic initial conditions to avoid a singularity. This "
"can sometimes slow down the solver, but is kept True as default for \"safe\" "
"mode as it seems to be more robust (False by default for other modes)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:53
msgid ""
"The maximum number of integrators that the solver will retain before "
"ejecting past integrators using an LRU methodology. A value of 0 or None "
"leaves the number of integrators unbound. Default is 100."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver:58
msgid "**Extends:** :class:`pybamm.solvers.base_solver.BaseSolver`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_solver.py:docstring
#: of pybamm.solvers.casadi_solver.CasadiSolver.create_integrator:1
msgid ""
"Method to create a casadi integrator object. If t_eval is provided, the "
"integrator uses t_eval to make the grid. Otherwise, the integrator has grid "
"[0,1]."
msgstr ""
