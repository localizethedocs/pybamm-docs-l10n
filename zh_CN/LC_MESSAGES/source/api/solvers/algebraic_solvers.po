#: of pybamm.solvers.casadi_algebraic_solver.CasadiAlgebraicSolver:12
msgid ""
"Any options to pass to the CasADi rootfinder. Please consult `CasADi "
"documentation <https://web.casadi.org/python-api/#rootfinding>`_ for "
"details. By default:  .. code-block:: python      extra_options = "
"{         # Whether to throw an error if the solver fails to "
"converge.         \"error_on_fail\": False,         # Verbosity "
"level         \"verbose\": False,         # Whether to show warnings when "
"evaluating the model         \"show_eval_warnings\": False,     }"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_algebraic_solver.py:docstring
#: of pybamm.solvers.casadi_algebraic_solver.CasadiAlgebraicSolver:12
msgid ""
"Any options to pass to the CasADi rootfinder. Please consult `CasADi "
"documentation <https://web.casadi.org/python-api/#rootfinding>`_ for "
"details. By default:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_algebraic_solver.py:docstring
#: of pybamm.solvers.casadi_algebraic_solver.CasadiAlgebraicSolver:16
msgid ""
"extra_options = {\n"
"    # Whether to throw an error if the solver fails to converge.\n"
"    \"error_on_fail\": False,\n"
"    # Verbosity level\n"
"    \"verbose\": False,\n"
"    # Whether to show warnings when evaluating the model\n"
"    \"show_eval_warnings\": False,\n"
"}"
msgstr ""
