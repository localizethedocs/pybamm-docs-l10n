#: ../../../source/api/solvers/algebraic_solvers.rst:2
msgid "Algebraic Solvers"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/algebraic_solver.py:docstring
#: of pybamm.solvers.algebraic_solver.AlgebraicSolver:1
msgid ""
"Solve a discretised model which contains only (time independent) algebraic "
"equations using a root finding algorithm. Uses scipy.optimize.root. Note: "
"this solver could be extended for quasi-static models, or models in which "
"the time derivative is manually discretised and results in a (possibly "
"nonlinear) algebaric system at each time level."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/casadi_algebraic_solver.py:docstring
#: of pybamm.solvers.casadi_algebraic_solver.CasadiAlgebraicSolver:0
#: ../../../source/api/solvers/algebraic_solvers.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/algebraic_solver.py:docstring
#: of pybamm.solvers.algebraic_solver.AlgebraicSolver:8
msgid ""
"The method to use to solve the system (default is \"lm\"). If it starts with "
"\"lsq\", least-squares minimization is used. The method for least-squares "
"can be specified in the form \"lsq_methodname\""
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/algebraic_solver.py:docstring
#: of pybamm.solvers.algebraic_solver.AlgebraicSolver:12
msgid "The tolerance for the solver (default is 1e-6)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/algebraic_solver.py:docstring
#: of pybamm.solvers.algebraic_solver.AlgebraicSolver:14
msgid ""
"Any options to pass to the rootfinder. Vary depending on which method is "
"chosen. Please consult `SciPy documentation <https://docs.scipy.org/doc/"
"scipy/reference/generated/scipy.optimize.show_options.html>`_ for details. "
"Addititional options to pass to the solver, by default:  .. code-block:: "
"python      extra_options = {         # Tolerance for termination by the "
"change of the independent variables.         \"xtol\": 1e-12,         # "
"Tolerance for termination by the norm of the gradient.         \"gtol\": "
"1e-12,     }"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/algebraic_solver.py:docstring
#: of pybamm.solvers.algebraic_solver.AlgebraicSolver:14
msgid ""
"Any options to pass to the rootfinder. Vary depending on which method is "
"chosen. Please consult `SciPy documentation <https://docs.scipy.org/doc/"
"scipy/reference/generated/scipy.optimize.show_options.html>`_ for details. "
"Addititional options to pass to the solver, by default:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/algebraic_solver.py:docstring
#: of pybamm.solvers.algebraic_solver.AlgebraicSolver:19
msgid ""
"extra_options = {\n"
"    # Tolerance for termination by the change of the independent variables.\n"
"    \"xtol\": 1e-12,\n"
"    # Tolerance for termination by the norm of the gradient.\n"
"    \"gtol\": 1e-12,\n"
"}"
msgstr ""

