#: ../../../source/api/plotting/plot_3d_heatmap.rst:2
msgid "Plot 3D Heatmap"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:1
msgid ""
"Creates a 3D scatter plot of a variable from a PyBaMM solution with a 3D "
"mesh."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:3
msgid ""
"This function visualizes the solution directly on the FEM nodes, providing a "
"true representation of the 3D data."
msgstr ""

#: ../../../source/api/plotting/plot_3d_heatmap.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:6
msgid "The solution object containing the 3D variable."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:8
msgid ""
"The name of the 3D variable to plot (default: \"Cell temperature [K]\")."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:10
msgid "The time at which to plot. If None, the last timestep is used."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:12
msgid ""
"A 3D axes object on which to draw the plot. If None, a new figure and axes "
"are created."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:15
msgid "Whether to display the plot (default: True)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:17
msgid "The colormap for the plot (default: 'inferno')."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:19
msgid "The size of the markers in the scatter plot (default: 10)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:21
msgid ""
"The transparency of the markers (0=transparent, 1=opaque). Default is 0.7."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_heatmap.py:docstring
#: of pybamm.plotting.plot_3d_heatmap.plot_3d_heatmap:23
msgid "If True, uses scientific notation for the color bar (default: False)."
msgstr ""

