"Generate a plot showing the component overpotentials that make up the voltage"
msgstr ""

#: ../../../source/api/plotting/plot_voltage_components.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:3
msgid "Solution or Simulation object from which to extract voltage components."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:5
msgid ""
"The axis on which to put the plot. If None, a new figure and axis is created."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:7
msgid "Whether to display the legend. Default is True"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:9
msgid ""
"Whether to show the overpotentials for the negative and positive electrodes "
"separately. Default is False."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:12
msgid ""
"The phases for which to plot the anode and cathode overpotentials, "
"respectively. Default is `(\"primary\", \"primary\")`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:15
msgid ""
"Whether to show the plots. Default is True. Set to False if you want to only "
"display the plot after plt.show() has been called."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_voltage_components.py:docstring
#: of pybamm.plotting.plot_voltage_components.plot_voltage_components:18
