msgid "Plot Cross Section"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:1
msgid ""
"Plots a high-quality 2D cross-section of a 3D variable from a PyBaMM "
"solution, with mesh overlay support."
msgstr ""

#: ../../../source/api/plotting/plot_3d_cross_section.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:4
msgid "The solution object containing the 3D variable."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:6
msgid ""
"The name of the 3D variable to plot (default: \"Cell temperature [K]\")."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:8
msgid "The time at which to plot. If None, the last timestep is used."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:10
msgid "The plane for the cross-section ('xy', 'yz', 'xz', 'rz')."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:12
msgid "The relative position (0 to 1) along the third axis to take the slice."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:14
msgid "The number of points for the plotting grid in each direction."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:16
msgid "The axes on which to draw the plot. If None, a new figure is created."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:18
msgid "Whether to display the plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:20
msgid "The colormap for the plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:22
msgid "The number of contour levels for the plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_3d_cross_section.py:docstring
#: of pybamm.plotting.plot_3d_cross_section.plot_3d_cross_section:24
