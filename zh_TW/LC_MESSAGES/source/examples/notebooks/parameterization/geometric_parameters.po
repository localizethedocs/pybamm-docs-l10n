#: ../../../source/examples/notebooks/parameterization/geometric_parameters.ipynb:364
msgid "Showing the difference in time needed to change the parameters"
msgstr ""

#: ../../../source/examples/notebooks/parameterization/geometric_parameters.ipynb:366
msgid ""
"Finally, we show the difference in time needed to change the parameters. "
"Using the symbolic mesh results in a ~10x speedup due to the omission of the "
"model build and discretisation steps. While this speedup is relatively small "
"for one iteration, it becomes significant when iterating over many parameter "
"values such as in large parameter sweeps or optimization problems."
msgstr ""

#: ../../../source/examples/notebooks/parameterization/geometric_parameters.ipynb:-1
msgid "[12]:"
msgstr ""

#: ../../../source/examples/notebooks/parameterization/geometric_parameters.ipynb:-1
msgid ""
"import timeit\n"
"\n"
"time_uniform = timeit.timeit(lambda: solve_model_with_uniform_mesh(1, 3, 5), "
"number=100)\n"
"time_symbolic = timeit.timeit(\n"
"    lambda: solve_model_with_symbolic_mesh(1, 3, 5), number=100\n"
")\n"
"print(f\"Time for uniform mesh: {time_uniform} seconds\")\n"
"print(f\"Time for symbolic mesh: {time_symbolic} seconds\")\n"
"print(f\"Ratio: {time_uniform / time_symbolic}\")"
msgstr ""

