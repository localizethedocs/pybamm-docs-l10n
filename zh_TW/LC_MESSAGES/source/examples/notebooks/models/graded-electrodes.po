"    solutions,\n"
"    output_variables=[\"Negative electrode porosity\", \"Positive electrode "
"porosity\"],\n"
"    labels=[\n"
"        \"Constant porosity\",\n"
"        \"Low porosity at separator\",\n"
"        \"High porosity at separator\",\n"
"    ],\n"
")"
msgstr ""

