#: ../../../source/examples/notebooks/models/half-cell.ipynb:9
msgid "Half-cell models in PyBaMM"
msgstr ""

#: ../../../source/examples/notebooks/models/half-cell.ipynb:11
msgid ""
"PyBaMM supports both negative and positive half-cells. In both cases, the "
"working electrode is considered to be the positive electrode and lithium "
"metal the negative electrode. The difference is solely down to the material "
"the positive electrode is made of. This notebook demonstrates how to "
"simulate half-cells made of a range of materials."
msgstr ""

#: ../../../source/examples/notebooks/models/half-cell.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/models/half-cell.ipynb:-1
msgid ""
"%pip install pybamm -q  # install PyBaMM if it is not installed\n"
"import matplotlib.pyplot as plt\n"
"\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/models/half-cell.ipynb:35
msgid ""
"<pre>\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"</pre>"
msgstr ""

