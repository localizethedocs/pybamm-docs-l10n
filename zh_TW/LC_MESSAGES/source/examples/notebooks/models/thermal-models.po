#: ../../../source/examples/notebooks/models/thermal-models.ipynb:650
msgid ""
"For the lumped model, we can compare how the contact resistance affects the "
"heating. To do so, we must set the ``\"contact resistance\"`` option to "
"``\"true\"`` and update the ``\"Contact resistance [Ohm]\"`` parameter."
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:-1
msgid ""
"model_no_contact_resistance = pybamm.lithium_ion.SPMe(\n"
"    {\"cell geometry\": \"arbitrary\", \"thermal\": \"lumped\", \"contact "
"resistance\": \"false\"},\n"
"    name=\"lumped thermal model\",\n"
")\n"
"model_contact_resistance = pybamm.lithium_ion.SPMe(\n"
"    {\"cell geometry\": \"arbitrary\", \"thermal\": \"lumped\", \"contact "
"resistance\": \"true\"},\n"
"    name=\"lumped thermal model with contact resistance\",\n"
")\n"
"models = [model_no_contact_resistance, model_contact_resistance]"
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:679
msgid "We then choose a parameter set."
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:-1
msgid ""
"parameter_values = pybamm.ParameterValues(\"Marquis2019\")\n"
"lumped_params = parameter_values.copy()\n"
"lumped_params_contact_resistance = parameter_values.copy()"
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:702
msgid ""
"For the contact resistance model, we must specify a contact resistance "
"greater than zero. The default is zero."
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:-1
msgid ""
"lumped_params_contact_resistance.update(\n"
"    {\n"
"        \"Contact resistance [Ohm]\": 0.05,\n"
"    }\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:727
msgid "The models and parameters are then used to solve for a 1C discharge."
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:-1
msgid ""
"params = [lumped_params, lumped_params_contact_resistance]\n"
"sols = []\n"
"for model, param in zip(models, params, strict=False):\n"
"    sim = pybamm.Simulation(model, parameter_values=param)\n"
"    sim.solve([0, 3600])\n"
"    sols.append(sim.solution)"
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:753
msgid ""
"We can then compare the voltage and cell temperature and see the impact of "
"the contact resistance."
msgstr ""

#: ../../../source/examples/notebooks/models/thermal-models.ipynb:-1
msgid ""
"output_variables = [\n"
"    \"Voltage [V]\",\n"
"    \"X-averaged cell temperature [K]\",\n"
"    \"Cell temperature [K]\",\n"
"]\n"
"pybamm.dynamic_plot(sols, output_variables)"
msgstr ""

