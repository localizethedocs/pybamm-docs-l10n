#: ../../../source/examples/notebooks/models/SEI-on-cracks.ipynb:9
msgid "Modelling SEI growth on particle cracks"
msgstr ""

#: ../../../source/examples/notebooks/models/SEI-on-cracks.ipynb:11
msgid ""
"This notebook provides a short demonsration of how the SEI and particle "
"mechanics submodels can be combined to simulate SEI growth on particle "
"cracks."
msgstr ""

#: ../../../source/examples/notebooks/models/SEI-on-cracks.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/models/SEI-on-cracks.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import matplotlib.pyplot as plt\n"
"\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/models/SEI-on-cracks.ipynb:35
msgid ""
"<pre>\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/models/SEI-on-cracks.ipynb:41
msgid ""
