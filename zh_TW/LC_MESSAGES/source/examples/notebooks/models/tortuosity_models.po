#: ../../../source/examples/notebooks/models/tortuosity_models.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/models/tortuosity_models.ipynb:-1
msgid ""
"parameter_values.update(\n"
"    {\n"
"        \"Negative electrode tortuosity factor (electrolyte)\": 0.3 ** "
"(-0.5),\n"
"        \"Positive electrode tortuosity factor (electrolyte)\": 0.3 ** "
"(-0.5),\n"
"        \"Negative electrode tortuosity factor (electrode)\": 0.7 ** "
"(-0.5),\n"
"        \"Positive electrode tortuosity factor (electrode)\": 0.7 ** "
"(-0.5),\n"
"        \"Separator tortuosity factor (electrolyte)\": 1.0,\n"
"    }\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/tortuosity_models.ipynb:230
msgid ""
"N.B the differences in the exponent constants used to modify the porosity "
"and solid volume fraction. The existing Bruggeman model applies the exponent "
"directly to the porosity :math:`\\mathcal{B}=\\epsilon^{b}=\\epsilon^{3/2}`, "
"the tortuosity factor model applies the tortuosity factor with includes the "
"relation on porosity in this case :math:`\\mathcal{B}=\\epsilon / \\tau = "
"\\epsilon / \\epsilon^{-1/2} = \\epsilon^{3/2}`."
msgstr ""

#: ../../../source/examples/notebooks/models/tortuosity_models.ipynb:-1
msgid "[7]:"
msgstr ""

#: ../../../source/examples/notebooks/models/tortuosity_models.ipynb:-1
msgid ""
