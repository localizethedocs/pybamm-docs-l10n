#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:97
msgid "1. Load models"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:108
msgid ""
"Since the three models we want to compare are already implemented in PyBaMM, "
"they can be easy loaded using:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"dfn = pybamm.lithium_ion.DFN()\n"
"spme = pybamm.lithium_ion.SPMe()\n"
"spm = pybamm.lithium_ion.SPM()"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:131
msgid ""
"To allow us to perform the same operations on each model easily, we create a "
"dictionary of these three models:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "models = {\"DFN\": dfn, \"SPM\": spm, \"SPMe\": spme}"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:152
msgid "Each model can then be accessed using:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "models[\"DFN\"]"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:174
msgid ""
"<pre>\n"
"&lt;pybamm.models.full_battery_models.lithium_ion.dfn.DFN at "
"0x1208c3380&gt;\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:180
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"<pybamm.models.full\\_battery\\_models.lithium\\_ion.dfn.DFN at "
"0x1208c3380>\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:187
msgid "<pybamm.models.full_battery_models.lithium_ion.dfn.DFN at 0x1208c3380>"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:198
msgid ""
"For each model, we must also provide a cell geometry. The geometry is "
"different for different models; for example, the SPM has solves for a single "
"particle in each electrode whereas the DFN solves for many particles. For "
"simplicity, we use the default geometry associated with each model but note "
"that this can be easily changed."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"geometry = {\n"
"    \"DFN\": dfn.default_geometry,\n"
"    \"SPM\": spm.default_geometry,\n"
"    \"SPMe\": spme.default_geometry,\n"
"}"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:224
msgid "2. Process parameters"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:235
msgid ""
"For simplicity, we use the default parameters values associated with the DFN "
"model, but change the current function to be an input so that we can quickly "
"solve the model with different currents"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"param = dfn.default_parameter_values\n"
"param[\"Current function [A]\"] = \"[input]\""
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:257
msgid "It is simple to change this to a different parameter set if desired."
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:259
msgid ""
"We then process the parameters in each of the models and geometries using "
"this parameter set:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[7]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"for model_name, model in models.items():\n"
"    param.process_model(model)\n"
"    param.process_geometry(geometry[model_name])"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:283
msgid "3. Mesh geometry"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:294
msgid ""
"We use the defaults mesh properties (the types of meshes and number of "
"points to be used) for simplicity to generate a mesh of each model geometry. "
"We store these meshes in a dictionary of similar structure to the geometry "
"and models dictionaries:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[8]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"mesh = {}\n"
"for model_name, model in models.items():\n"
"    mesh[model_name] = pybamm.Mesh(\n"
"        geometry[model_name], model.default_submesh_types, model."
"default_var_pts\n"
"    )"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:320
msgid "4. Discretise model"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:331
msgid ""
"We now discretise each model using its associated mesh and the default "
"spatial method associated with the model:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[9]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"for model_name, model in models.items():\n"
"    disc = pybamm.Discretisation(mesh[model_name], model."
"default_spatial_methods)\n"
"    disc.process_model(model)"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:355
msgid "5. Solve model"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:366
msgid ""
"We now solve each model using the default solver associated with each model:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[10]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"timer = pybamm.Timer()\n"
"solutions = {}\n"
"t_eval = [0, 3600]  # time in seconds\n"
"for model_name, model in models.items():\n"
"    solver = pybamm.IDAKLUSolver()\n"
"    timer.reset()\n"
"    solution = solver.solve(model, t_eval, inputs={\"Current function [A]\": "
"1})\n"
"    print(f\"Solved the {model.name} in {timer.time()}\")\n"
"    solutions[model_name] = solution"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:395
msgid ""
"<pre>\n"
"Solved the Doyle-Fuller-Newman model in 68.203 ms\n"
"Solved the Single Particle Model in 15.638 ms\n"
"Solved the Single Particle Model with electrolyte in 32.645 ms\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:403
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"Solved the Doyle-Fuller-Newman model in 68.203 ms\n"
"Solved the Single Particle Model in 15.638 ms\n"
"Solved the Single Particle Model with electrolyte in 32.645 ms\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:412
msgid ""
"Solved the Doyle-Fuller-Newman model in 68.203 ms\n"
"Solved the Single Particle Model in 15.638 ms\n"
"Solved the Single Particle Model with electrolyte in 32.645 ms"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:426
msgid "6. Plot results"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:437
msgid ""
"To plot results, we extract the variables from the solutions dictionary. "
"Matplotlib can then be used to plot the voltage predictions of each models "
"as follows:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[11]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"for model_name, model in models.items():\n"
"    time_solution = solutions[model_name][\"Time [s]\"].entries\n"
"    time = np.linspace(time_solution[0], time_solution[-1], 100)\n"
"    voltage = solutions[model_name][\"Voltage [V]\"](time)\n"
"    plt.plot(time, voltage, lw=2, label=model.name)\n"
"plt.xlabel(\"Time [s]\", fontsize=15)\n"
"plt.ylabel(\"Voltage [V]\", fontsize=15)\n"
"plt.legend(fontsize=15)\n"
"plt.show()"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:474
msgid ""
"Alternatively the inbuilt ``QuickPlot`` functionality can be employed to "
"compare a set of variables over the discharge. We must first create a list "
"of the solutions"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[12]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "list_of_solutions = list(solutions.values())"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:495
msgid "And then employ ``QuickPlot``:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid "[13]:"
msgstr ""

#: ../../../source/examples/notebooks/models/compare-lithium-ion.ipynb:-1
msgid ""
"quick_plot = pybamm.QuickPlot(list_of_solutions)\n"
"quick_plot.dynamic_plot();"
msgstr ""

