#: ../../../source/examples/notebooks/getting_started/tutorial-6-managing-simulation-outputs.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import matplotlib.pyplot as plt\n"
"import numpy as np\n"
"\n"
"import pybamm\n"
"\n"
"model = pybamm.lithium_ion.SPMe()\n"
"sim = pybamm.Simulation(model)\n"
"sim.solve([0, 3600])"
