#: ../../../source/examples/notebooks/performance/07-multithreading.ipynb:9
msgid "Running many simulations in parallel using OpenMP"
msgstr ""

#: ../../../source/examples/notebooks/performance/07-multithreading.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/performance/07-multithreading.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import time\n"
"\n"
"import numpy as np\n"
"\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/performance/07-multithreading.ipynb:35
msgid ""
"<pre>\n"
