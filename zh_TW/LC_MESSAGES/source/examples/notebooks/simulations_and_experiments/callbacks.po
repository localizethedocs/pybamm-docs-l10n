msgid "Custom callbacks"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/callbacks.ipynb:303
msgid ""
"Custom callbacks should subclass the class ``pybamm.callbacks.Callback`` "
"class, and implement a subset of the callback methods ``on_<event>``, which "
"all take as input the dictionary ``logs``."
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/callbacks.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/callbacks.ipynb:-1
msgid ""
"class CustomCallback(pybamm.callbacks.Callback):\n"
"    def on_experiment_end(self, logs):\n"
"        print(f\"We are at the end of the simulation. Logs are {logs}\")"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/callbacks.ipynb:-1
msgid "[5]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/callbacks.ipynb:-1
msgid ""
"# Note the default `LoggingCallback` is also called\n"
"sim.solve(callbacks=CustomCallback());"
msgstr ""

