#: ../../../source/api/models/lead_acid/base_lead_acid_model.rst:0
msgid "Parameters"
msgstr "參數"

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lead_acid/base_lead_acid_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lead_acid.base_lead_acid_model.BaseModel:4
msgid ""
"A dictionary of options to be passed to the model. If this is a dict (and "
"not a subtype of dict), it will be processed by :class:`pybamm."
"BatteryModelOptions` to ensure that the options are valid. If this is a "
"subtype of dict, it is assumed that the options have already been processed "
"and are valid. This allows for the use of custom options classes. The "
"default options are given by :class:`pybamm.BatteryModelOptions`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lead_acid/base_lead_acid_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lead_acid.base_lead_acid_model.BaseModel:11
msgid "The name of the model. The default is \"Unnamed battery model\"."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lead_acid/base_lead_acid_model.py:docstring
#: of
#: pybamm.models.full_battery_models.lead_acid.base_lead_acid_model.BaseModel:13
msgid ""
"Whether to build the model on instantiation. Default is True. Setting this "
"option to False allows users to change any number of the submodels before "
"building the complete model (submodels cannot be changed after the model is "
"built)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lead_acid/base_lead_acid_model.py:docstring
