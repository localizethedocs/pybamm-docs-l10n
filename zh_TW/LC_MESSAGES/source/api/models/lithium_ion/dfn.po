#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/basic_dfn_half_cell.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.basic_dfn_half_cell.BasicDFNHalfCell:1
msgid ""
"Doyle-Fuller-Newman (DFN) model of a lithium-ion battery with lithium "
"counter electrode, adapted from :footcite:t:`Doyle1993`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/basic_dfn_half_cell.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.basic_dfn_half_cell.BasicDFNHalfCell:4
msgid ""
"This class differs from the :class:`pybamm.lithium_ion.BasicDFN` model class "
"in that it is for a cell with a lithium counter electrode (half cell). This "
"is a feature under development (for example, it cannot be used with the "
"Experiment class for the moment) and in the future it will be incorporated "
"as a standard model with the full functionality."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/basic_dfn_half_cell.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.basic_dfn_half_cell.BasicDFNHalfCell:10
msgid ""
"The electrode labeled \"positive electrode\" is the working electrode, and "
"the electrode labeled \"negative electrode\" is the counter electrode. This "
"facilitates compatibility with the full-cell models."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/full_battery_models/lithium_ion/basic_dfn_half_cell.py:docstring
#: of
#: pybamm.models.full_battery_models.lithium_ion.basic_dfn_half_cell.BasicDFNHalfCell:14
msgid ""
"A dictionary of options to be passed to the model. For the half cell it "
"should include which is the working electrode."
msgstr ""

