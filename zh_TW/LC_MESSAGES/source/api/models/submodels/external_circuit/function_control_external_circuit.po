msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/external_circuit/function_control_external_circuit.py:docstring
#: of
#: pybamm.models.submodels.external_circuit.function_control_external_circuit.FunctionControl.set_algebraic:1
msgid ""
"A method to set the differential equations which do not contain a time "
"derivative. Note: this method modifies the state of self.algebraic. Unless "
"overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/external_circuit/function_control_external_circuit.py:docstring
#: of
#: pybamm.models.submodels.external_circuit.function_control_external_circuit.FunctionControl.set_algebraic:6
#: pybamm.models.submodels.external_circuit.function_control_external_circuit.FunctionControl.set_initial_conditions:7
#: pybamm.models.submodels.external_circuit.function_control_external_circuit.FunctionControl.set_rhs:6
msgid "The variables in the whole model."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/external_circuit/function_control_external_circuit.py:docstring
#: of
#: pybamm.models.submodels.external_circuit.function_control_external_circuit.FunctionControl.set_initial_conditions:1
msgid ""
"A method to set the initial conditions for the submodel. Note: this method "
"modifies the state of self.initial_conditions. Unless overwritten by a "
"submodel, the default behaviour of 'pass' is used as implemented in :class:"
"`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/external_circuit/function_control_external_circuit.py:docstring
#: of
#: pybamm.models.submodels.external_circuit.function_control_external_circuit.FunctionControl.set_rhs:1
msgid ""
"A method to set the right hand side of the differential equations which "
"contain a time derivative. Note: this method modifies the state of self.rhs. "
"Unless overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""

