#: ../../../source/api/models/submodels/current_collector/effective_resistance_current_collector.rst:2
msgid "Effective Current collector Resistance models"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/current_collector/effective_resistance_current_collector.py:docstring
#: of
#: pybamm.models.submodels.current_collector.effective_resistance_current_collector.EffectiveResistance:1
msgid ""
"A model which calculates the effective Ohmic resistance of the current "
"collectors in the limit of large electrical conductivity. For details see :"
"footcite:t:`Timms2021`. Note that this formulation assumes uniform "
"*potential* across the tabs. See :class:`pybamm."
"AlternativeEffectiveResistance2D` for the formulation that assumes a uniform "
"*current density* at the tabs (in 1D the two formulations are equivalent)."
msgstr ""

