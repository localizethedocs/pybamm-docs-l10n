#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/composite_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.composite_ohm.Composite:1
msgid ""
"An explicit composite leading and first order solution to solid phase "
"current conservation with ohm's law. Note that the returned current density "
"is only the leading order approximation."
msgstr ""

