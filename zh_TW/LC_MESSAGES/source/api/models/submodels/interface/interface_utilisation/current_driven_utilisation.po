#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/interface/interface_utilisation/current_driven_utilisation.py:docstring
#: of
#: pybamm.models.submodels.interface.interface_utilisation.current_driven_utilisation.CurrentDriven.set_initial_conditions:1
msgid ""
"A method to set the initial conditions for the submodel. Note: this method "
"modifies the state of self.initial_conditions. Unless overwritten by a "
"submodel, the default behaviour of 'pass' is used as implemented in :class:"
"`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/interface/interface_utilisation/current_driven_utilisation.py:docstring
#: of
#: pybamm.models.submodels.interface.interface_utilisation.current_driven_utilisation.CurrentDriven.set_rhs:1
msgid ""
"A method to set the right hand side of the differential equations which "
"contain a time derivative. Note: this method modifies the state of self.rhs. "
"Unless overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""
