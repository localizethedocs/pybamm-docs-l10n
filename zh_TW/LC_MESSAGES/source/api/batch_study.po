#: ../../../source/api/batch_study.rst:2
msgid "Batch Study"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:1
msgid "A BatchStudy class for comparison of different PyBaMM simulations."
msgstr ""

#: ../../../source/api/batch_study.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:3
msgid "A dictionary of models to be simulated"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:5
msgid ""
"A dictionary of experimental conditions under which to solve the model. "
"Default is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:8
msgid "A dictionary of geometries upon which to solve the model"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:10
msgid ""
"A dictionary of parameters and their corresponding numerical values. Default "
"is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:13
msgid ""
"A dictionary of the types of submesh to use on each subdomain. Default is "
"None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:16
msgid ""
"A dictionary of the number of points used by each spatial variable. Default "
"is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:19
msgid ""
"A dictionary of the types of spatial method to use on each domain. Default "
"is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:22
msgid "A dictionary of solvers to use to solve the model. Default is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:24
msgid "A dictionary of variables to plot automatically. Default is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:26
msgid ""
"A dictionary of C-rates at which you would like to run a constant current "
"(dis)charge. Default is None"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:29
msgid "The number of times `solve` should be called. Default is 1"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy:31
msgid ""
"If False runs first model with first solver, first experiment and second "
"model with second solver, second experiment etc. If True runs a cartesian "
"product of models, solvers and experiments. Default is False"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy.create_gif:1
msgid ""
"Generates x plots over a time span of t_eval and compiles them to create a "
"GIF. For more information see :meth:`pybamm.QuickPlot.create_gif`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy.create_gif:4
msgid "Number of images/plots to be compiled for a GIF."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy.create_gif:6
msgid "Duration of visibility of a single image/plot in the created GIF."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/batch_study.py:docstring
#: of pybamm.batch_study.BatchStudy.create_gif:8
msgid "Name of the generated GIF file."
msgstr ""

