#: ../../../source/api/simulation/simulation.rst:2
msgid "Simulation"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation:1
msgid "Extends :class:`BaseSimulation` with experiment support."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation:3
msgid "Accepts all parameters from :class:`BaseSimulation`, plus:"
msgstr ""

#: ../../../source/api/simulation/simulation.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation:5
msgid ""
"The experimental conditions under which to solve the model. If a string is "
"passed, the experiment is constructed as `pybamm.Experiment([experiment])`. "
"If a list is passed, the experiment is constructed as `pybamm."
"Experiment(experiment)`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation:10
msgid ""
"How to construct experiment models. Options are: ``\"legacy\"`` (default), "
"which always uses one model per step; and ``\"unified\"``, which requires "
"the shared experiment model path."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation:15
msgid "**Extends:** :class:`pybamm.simulation.base_simulation.BaseSimulation`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.build_for_experiment:1
msgid ""
"Similar to :meth:`Simulation.build`, but for the case of simulating an "
"experiment, where there may be several models and solvers to build."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.save:1
msgid "Save simulation using pickle module."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.save:3
msgid ""
"The file extension can be arbitrary, but it is common to use \".pkl\" or \"."
"pickle\""
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.save_model:1
msgid "Write out a discretised model to a JSON file"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.save_model:3
msgid ""
"The mesh used to discretise the model. If false, plotting tools will not be "
"available when the model is read back in and solved."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.save_model:6
msgid ""
"The discretised variables. Not required to solve a model, but if false tools "
"will not be available. Will automatically save meshes as well, required for "
"plotting tools."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.save_model:10
msgid ""
"The desired name of the JSON file. If no name is provided, one will be "
"created based on the model name, and the current datetime."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.solve:1
msgid "Solve the model, with experiment support."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.solve:3
msgid "Accepts all parameters from :meth:`BaseSimulation.solve`, plus:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.solve:5
msgid ""
"Which cycles to save the full sub-solutions for. If None, all cycles are "
"saved. If int, every multiple of save_at_cycles is saved. If list, every "
"cycle in the list is saved. The first cycle (cycle 1) is always saved."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.solve:9
msgid ""
"The solution to start stepping from. If None (default), then self._solution "
"is used. Must be None if not using an experiment."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/simulation/simulation.py:docstring
#: of pybamm.simulation.simulation.Simulation.solve:12
msgid ""
"Whether to show a progress bar for cycling. If true, shows a progress bar "
"for cycles. Has no effect when not used with an experiment. Default is False."
msgstr ""
