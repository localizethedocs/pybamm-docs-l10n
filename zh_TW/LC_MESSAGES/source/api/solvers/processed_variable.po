#: ../../../source/api/solvers/processed_variable.rst:2
msgid "Post-Process Variables"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:1
msgid ""
"An object that can be evaluated at arbitrary (scalars or vectors) t and x, "
"and returns the (interpolated) value of the base variable at that t and x."
msgstr ""

#: ../../../source/api/solvers/processed_variable.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:4
msgid "The name of the variable"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:6
msgid ""
"A list of base variables with a method `evaluate(t,y)`, each entry of which "
"returns the value of that variable for that particular sub-solution. A "
"Solution can be comprised of sub-solutions which are the solutions of "
"different models. Note that this can be any kind of node in the expression "
"tree, not just a :class:`pybamm.Variable`. When evaluated, returns an array "
"of size (m,n)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:14
msgid ""
"A list of casadi functions. When evaluated, returns the same thing as "
"`base_Variable.evaluate` (but more efficiently)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:17
msgid "The solution object to be used to create the processed variables"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:19
msgid "Not none if the variable is to be time-integrated (default is None)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable:22
msgid ""
"**Extends:** :class:`pybamm.solvers.base_processed_variable."
"BaseProcessedVariable`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable.as_computed:1
msgid ""
"Allows a ProcessedVariable to be converted to a ComputedProcessedVariable "
"for use together, e.g. when using a last state solution with a new "
"simulation running with output variables in the solver."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.ProcessedVariable.data:1
msgid "Same as entries, but different name"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.ProcessedVariable.entries:1
msgid ""
"Returns the raw data entries of the processed variable. If the processed "
"variable has not been initialized (i.e. the entries have not been "
"calculated), then the processed variable is initialized first."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of
#: pybamm.solvers.processed_variable.ProcessedVariable.initialise_sensitivity_explicit_forward:1
msgid "Set up the sensitivity dictionary"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable.observe_and_interp:1
msgid ""
"Interpolate the variable at the given time points and y values. t must be a "
"sorted array of time points."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.solvers.processed_variable.ProcessedVariable.observe_raw:1
msgid "Evaluate the base variable at the given time points and y values."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/solvers/processed_variable.py:docstring
#: of pybamm.ProcessedVariable.sensitivities:1
msgid ""
"Returns a dictionary of sensitivities for each input parameter. The keys are "
"the input parameters, and the value is a matrix of size (n_x * n_t, n_p), "
"where n_x is the number of states, n_t is the number of time points, and n_p "
"is the size of the input parameter"
msgstr ""
