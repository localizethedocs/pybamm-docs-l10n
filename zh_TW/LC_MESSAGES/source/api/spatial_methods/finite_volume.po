#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:7
msgid "The direction of integration (forward or backward). See notes."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:14
msgid "Notes"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:15
msgid "**Forward integral**"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:17
msgid ""
"F(x) = \\int_0^x\\!f(u)\\,du\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:20
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:44
msgid "The indefinite integral must satisfy the following conditions:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:22
msgid ":math:`F(0) = 0`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:23
msgid ":math:`f(x) = \\frac{dF}{dx}`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:25
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:49
msgid "or, in discrete form,"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:27
msgid "`BoundaryValue(F, \"left\") = 0`, i.e. :math:`3*F_0 - F_1 = 0`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:28
msgid ":math:`f_{i+1/2} = (F_{i+1} - F_i) / dx_{i+1/2}`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:30
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:54
msgid "Hence we must have"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:32
msgid ":math:`F_0 = du_{1/2} * f_{1/2} / 2`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:33
msgid ":math:`F_{i+1} = F_i + du_{i+1/2} * f_{i+1/2}`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:35
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:59
msgid ""
"Note that :math:`f_{-1/2}` and :math:`f_{end+1/2}` are included in the "
"discrete integrand vector `f`, so we add a column of zeros at each end of "
"the indefinite integral matrix to ignore these."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:39
msgid "**Backward integral**"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:41
msgid ""
"F(x) = \\int_x^{end}\\!f(u)\\,du\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:46
msgid ":math:`F(end) = 0`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:47
msgid ":math:`f(x) = -\\frac{dF}{dx}`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:51
msgid ""
"`BoundaryValue(F, \"right\") = 0`, i.e. :math:`3*F_{end} - F_{end-1} = 0`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:52
msgid ":math:`f_{i+1/2} = -(F_{i+1} - F_i) / dx_{i+1/2}`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:56
msgid ":math:`F_{end} = du_{end+1/2} * f_{end-1/2} / 2`"
msgstr ""

