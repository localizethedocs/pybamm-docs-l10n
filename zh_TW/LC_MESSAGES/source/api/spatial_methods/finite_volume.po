#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.gradient:1
msgid ""
"Matrix-vector multiplication to implement the gradient operator. See :meth:"
"`pybamm.SpatialMethod.gradient`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.gradient_matrix:1
msgid ""
"Gradient matrix for finite volumes in the appropriate domain. Equivalent to "
"grad(y) = (y[1:] - y[:-1])/dx"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.gradient_matrix:4
msgid ""
"The domain in which to compute the gradient matrix, including ghost nodes"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.gradient_matrix:7
msgid "The (sparse) finite volume gradient matrix for the domain"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral:1
msgid "Implementation of the indefinite integral operator."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:1
msgid ""
"Matrix for finite-volume implementation of the indefinite integral where the "
"integrand is evaluated on mesh edges (shape (n+1, 1)). The integral will "
"then be evaluated on mesh nodes (shape (n, 1))."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:5
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_nodes:6
