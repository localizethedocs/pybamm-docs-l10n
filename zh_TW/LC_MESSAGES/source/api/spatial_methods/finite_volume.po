#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.definite_integral_matrix:15
msgid "The dimension in which to integrate (default is \"primary\")"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.definite_integral_matrix:18
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:10
