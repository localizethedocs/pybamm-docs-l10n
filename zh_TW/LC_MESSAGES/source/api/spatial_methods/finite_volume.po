msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:1
msgid ""
"Add the known values of the gradient from Neumann boundary conditions to the "
"discretised gradient."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:4
msgid ""
"Dirichlet bcs are implemented using ghost nodes, see :meth:`pybamm."
"FiniteVolume.add_ghost_nodes`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:9
#: pybamm.spatial_methods.finite_volume.FiniteVolume.upwind_or_downwind:7
msgid "Contains the discretised gradient of symbol"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:15
msgid "The domain of the gradient of the symbol (may include ghost nodes)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:18
msgid ""
"`Matrix @ discretised_gradient + bcs_vector`. When evaluated, this gives the "
"discretised_gradient, with the values of the Neumann boundary conditions "
"concatenated at each end (if given)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.boundary_value_or_flux:1
msgid ""
"Uses extrapolation to get the boundary value or flux of a variable in the "
"Finite Volume Method."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.boundary_value_or_flux:4
msgid "See :meth:`pybamm.SpatialMethod.boundary_value`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.concatenation:1
msgid ""
"Discrete concatenation, taking `edge_to_node` for children that evaluate on "
"edges. See :meth:`pybamm.SpatialMethod.concatenation`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.definite_integral_matrix:1
msgid ""
"Matrix for finite-volume implementation of the definite integral in the "
"primary dimension"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.definite_integral_matrix:4
msgid ""
"I = \\int_{a}^{b}\\!f(s)\\,ds\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.definite_integral_matrix:7
msgid ""
"for where :math:`a` and :math:`b` are the left-hand and right-hand "
"boundaries of the domain respectively"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.definite_integral_matrix:10
