#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.delta_function:1
msgid ""
"Delta function. Implemented as a vector whose only non-zero element is the "
"first (if symbol.side = \"left\") or last (if symbol.side = \"right\"), with "
"appropriate value so that the integral of the delta function across the "
"whole domain is the same as the integral of the discretised symbol across "
"the whole domain."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.delta_function:7
msgid "See :meth:`pybamm.SpatialMethod.delta_function`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.divergence:1
msgid ""
"Matrix-vector multiplication to implement the divergence operator. See :meth:"
"`pybamm.SpatialMethod.divergence`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.divergence_matrix:1
msgid ""
"Divergence matrix for finite volumes in the appropriate domain. Equivalent "
"to div(N) = (N[1:] - N[:-1])/dx"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.divergence_matrix:4
msgid ""
"The domain(s) and auxiliary domain in which to compute the divergence matrix"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.divergence_matrix:7
msgid "The (sparse) finite volume divergence matrix for the domain"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.edge_to_node:1
msgid ""
"Convert a discretised symbol evaluated on the cell edges to a discretised "
"symbol evaluated on the cell nodes. See :meth:`pybamm.FiniteVolume.shift`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.evaluate_at:1
