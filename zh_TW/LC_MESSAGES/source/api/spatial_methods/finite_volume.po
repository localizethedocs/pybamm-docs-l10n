#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume:1
msgid ""
"A class which implements the steps specific to the finite volume method "
"during discretisation."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume:4
msgid ""
"For broadcast and mass_matrix, we follow the default behaviour from "
"SpatialMethod."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:0
#: ../../../source/api/spatial_methods/finite_volume.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume:6
msgid ""
"A dictionary of options to be passed to the spatial method. The only option "
"currently available is \"extrapolation\", which has options for \"order\" "
"and \"use_bcs\". It sets the order separately for `pybamm.BoundaryValue` and "
"`pybamm.BoundaryGradient`. Default is \"linear\" for the value and quadratic "
"for the gradient."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume:12
msgid ""
"**Extends:** :class:`pybamm.spatial_methods.spatial_method.SpatialMethod`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_ghost_nodes:1
msgid "Add ghost nodes to a symbol."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_ghost_nodes:3
msgid ""
"For Dirichlet bcs, for a boundary condition \"y = a at the left-hand "
"boundary\", we concatenate a ghost node to the start of the vector y with "
"value \"2*a - y1\" where y1 is the value of the first node. Similarly for "
"the right-hand boundary condition."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_ghost_nodes:8
msgid ""
"For Neumann bcs no ghost nodes are added. Instead, the exact value provided "
"by the boundary condition is used at the cell edge when calculating the "
"gradient (see :meth:`pybamm.FiniteVolume.add_neumann_values`)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_ghost_nodes:12
#: pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:7
#: pybamm.spatial_methods.finite_volume.FiniteVolume.upwind_or_downwind:5
msgid "The variable to be discretised"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_ghost_nodes:14
msgid "Contains the discretised variable"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of pybamm.spatial_methods.finite_volume.FiniteVolume.add_ghost_nodes:16
#: pybamm.spatial_methods.finite_volume.FiniteVolume.add_neumann_values:11
#: pybamm.spatial_methods.finite_volume.FiniteVolume.upwind_or_downwind:9
msgid ""
"Dictionary (with keys \"left\" and \"right\") of boundary conditions. Each "
"boundary condition consists of a value and a flag indicating its type (e.g. "
"\"Dirichlet\")"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/finite_volume.py:docstring
#: of
#: pybamm.spatial_methods.finite_volume.FiniteVolume.indefinite_integral_matrix_edges:0
