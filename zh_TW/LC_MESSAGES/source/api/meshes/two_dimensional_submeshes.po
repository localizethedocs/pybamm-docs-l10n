#: ../../../source/api/meshes/two_dimensional_submeshes.rst:2
msgid "2D Sub Meshes"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D:1
msgid ""
"2D submesh class. Contains information about the 2D finite element mesh. "
"Note: This class only allows for the use of piecewise-linear triangular "
"finite elements."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:0
#: pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:0
#: pybamm.meshes.scikit_fem_submeshes.ScikitUniform2DSubMesh:0
#: pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:0
#: ../../../source/api/meshes/two_dimensional_submeshes.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D:6
msgid ""
"An array containing the points corresponding to the edges of the submesh"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D:8
msgid "The coordinate system of the submesh"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D:10
msgid ""
"A dictionary that contains information about the size and location of the "
"tabs"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D:14
msgid "**Extends:** :class:`pybamm.meshes.meshes.SubMesh`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D.on_boundary:1
msgid ""
"A method to get the degrees of freedom corresponding to the subdomains for "
"the tabs."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitUniform2DSubMesh:1
msgid ""
"Contains information about the 2D finite element mesh with uniform grid "
"spacing (can be different spacing in y and z). Note: This class only allows "
"for the use of piecewise-linear triangular finite elements."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:17
#: pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:17
#: pybamm.meshes.scikit_fem_submeshes.ScikitUniform2DSubMesh:6
msgid "A dictionary that contains the limits of each spatial variable"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:20
#: pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:20
#: pybamm.meshes.scikit_fem_submeshes.ScikitUniform2DSubMesh:9
msgid ""
"A dictionary that contains the number of points to be used on each spatial "
"variable"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:24
#: pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:29
#: pybamm.meshes.scikit_fem_submeshes.ScikitUniform2DSubMesh:13
#: pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:18
msgid ""
"**Extends:** :class:`pybamm.meshes.scikit_fem_submeshes.ScikitSubMesh2D`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:1
msgid ""
"Contains information about the 2D finite element mesh generated by taking "
"the tensor product of a uniformly spaced grid in the y direction, and a "
"unequally spaced grid in the z direction in which the points are clustered "
"close to the top boundary using an exponential formula on the interval [a,"
"b]. The gridpoints in the z direction are given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:7
msgid ""
"z_{k} = (b-a) + \\frac{\\exp{-\\alpha k / N} - 1}{\\exp{-\\alpha} - 1} + a,\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:10
msgid ""
"for k = 1, ..., N, where N is the number of nodes. Here alpha is a "
"stretching factor. As the number of gridpoints tends to infinity, the ratio "
"of the largest and smallest grid cells tends to exp(alpha)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:14
msgid ""
"Note: in the future this will be extended to allow points to be clustered "
"near any of the boundaries."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:23
msgid ""
"Whether the points are clustered near to a particular boundary. At present, "
"can only be \"top\". Default is \"top\"."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitExponential2DSubMesh:26
msgid "The factor (alpha) which appears in the exponential. Default is 2.3."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:1
msgid ""
"Contains information about the 2D finite element mesh generated by taking "
"the tensor product of two 1D meshes which use Chebyshev nodes on the "
"interval (a, b), given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:5
msgid ""
"x_{k} = \\frac{1}{2}(a+b) + \\frac{1}{2}(b-a) \\cos(\\frac{2k-1}{2N}\\pi),\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:8
msgid ""
"for k = 1, ..., N, where N is the number of nodes. Note: this mesh then "
"appends the boundary edgess, so that the 1D mesh edges are given by"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:11
msgid ""
"a < x_{1} < ... < x_{N} < b.\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.ScikitChebyshev2DSubMesh:14
msgid ""
"Note: This class only allows for the use of piecewise-linear triangular "
"finite elements."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:1
msgid ""
"A class to generate a tensor product submesh on a 2D domain by using two "
"user supplied vectors of edges: one for the y-direction and one for the z-"
"direction. Note: this mesh should be created using :class:"
"`UserSupplied2DSubMeshGenerator`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:5
msgid "A dictionary that contains the limits of the spatial variables"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:7
msgid ""
"A dictionary that contains the number of points to be used on each spatial "
"variable. Note: the number of nodes (located at the cell centres) is npts, "
"and the number of edges is npts+1."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:11
msgid ""
"The array of points which correspond to the edges in the y direction of the "
"mesh."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/meshes/scikit_fem_submeshes.py:docstring
#: of pybamm.meshes.scikit_fem_submeshes.UserSupplied2DSubMesh:14
msgid ""
"The array of points which correspond to the edges in the z direction of the "
"mesh."
msgstr ""
