#: of pybamm.expression_tree.array.Array.create_copy:1
msgid "See :meth:`pybamm.Symbol.new_copy()`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array.is_constant:1
msgid "See :meth:`pybamm.Symbol.is_constant()`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.Array.ndim:1
