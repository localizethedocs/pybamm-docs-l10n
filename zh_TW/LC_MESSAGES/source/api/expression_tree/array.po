msgid "Array"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:1
msgid ""
"Node in the expression tree that holds an tensor type variable (e.g. :class:"
"`numpy.array`)"
msgstr ""

#: ../../../source/api/expression_tree/array.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:4
msgid ""
"the array associated with the node. If a list is provided, it is converted "
"to a numpy array"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:7
msgid "the name of the node"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:9
msgid "list of domains the parameter is valid over, defaults to empty list"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:11
msgid "dictionary of auxiliary domains, defaults to empty dict"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:13
msgid ""
"A dictionary equivalent to {'primary': domain, auxiliary_domains}. Either "
"'domain' and 'auxiliary_domains', or just 'domains', should be provided (not "
"both). In future, the 'domain' and 'auxiliary_domains' arguments may be "
"deprecated."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:18
msgid "String representing the entries (slow to recalculate when copying)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array:21
msgid "**Extends:** :class:`pybamm.expression_tree.symbol.Symbol`"
msgstr ""

