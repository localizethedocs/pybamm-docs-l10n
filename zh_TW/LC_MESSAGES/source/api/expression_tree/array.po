msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.expression_tree.array.Array.set_id:1
msgid "See :meth:`pybamm.Symbol.set_id()`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/expression_tree/array.py:docstring
#: of pybamm.Array.shape:1
