#: ../../../source/user_guide/installation/windows-wsl.rst:2
msgid "Install from source (Windows Subsystem for Linux)"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:4
msgid ""
"To make it easier to install PyBaMM, we recommend using the Windows "
"Subsystem for Linux (WSL) along with Visual Studio Code. This guide will "
"walk you through the process."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:7
msgid "Install WSL"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:9
msgid ""
"Install Ubuntu 22.04 or 20.04 LTS as a distribution for WSL following "
"`Microsoft's guide to install WSL <https://learn.microsoft.com/en-us/windows/"
"wsl/install-win10>`__."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:12
msgid "Install PyBaMM"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:15
msgid "Get PyBaMM's Source Code"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:17
msgid ""
"Open a terminal in your Ubuntu distribution by selecting \"Ubuntu\" from the "
"Start menu. You'll get a bash prompt in your home directory."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:19
msgid "Install Git by typing the following command:"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:21
msgid "sudo apt install git-core"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:25
msgid "Clone the PyBaMM repository:"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:27
msgid "git clone https://github.com/pybamm-team/PyBaMM.git"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:31
msgid "Enter the PyBaMM Directory by running:"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:33
msgid "cd PyBaMM"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:38
msgid "5. Follow the Installation Steps"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:40
msgid ""
"Follow the :ref:`installation instructions for PyBaMM on Linux <install-from-"
"source>`."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:43
msgid "Using Visual Studio Code with the WSL"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:45
msgid ""
"To use Visual Studio Code with the Windows Subsystem for Linux (WSL), follow "
"these steps:"
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:47
msgid "Open Visual Studio Code."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:48
msgid "Install the \"Remote - WSL\" extension if not already installed."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:49
msgid "Open the PyBaMM directory in Visual Studio Code."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:50
msgid ""
"In the bottom pane, select the \"+\" sign and choose \"New WSL Window.\""
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:51
msgid "This opens a WSL terminal in the PyBaMM directory within the WSL."
msgstr ""

#: ../../../source/user_guide/installation/windows-wsl.rst:53
msgid ""
"Now you can develop and edit PyBaMM code using Visual Studio Code while "
"utilizing the WSL environment."
msgstr ""
