msgid "pip install pybamm"
msgstr ""

#: ../../../source/user_guide/installation/index.rst:26
msgid ""
"PyBaMM is available as a ``conda`` package through the conda-forge channel."
msgstr ""

#: ../../../source/user_guide/installation/index.rst:28
msgid ""
"The ``pybamm`` package on conda-forge installs PyBaMM with all the `required "
"and optional dependencies <#dependencies>`_ available on conda-forge."
msgstr ""

#: ../../../source/user_guide/installation/index.rst:30
msgid ""
"conda install -c conda-forge pybamm\n"
"\n"
"  The ``pybamm-base`` package installs PyBaMM only with its `required "
"dependencies <#install-required-dependencies>`_."
msgstr ""

