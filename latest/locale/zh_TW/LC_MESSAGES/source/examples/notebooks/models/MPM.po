#: ../../../source/examples/notebooks/models/MPM.ipynb:1166
msgid "Fickian diffusion vs Uniform profile"
msgstr ""

#: ../../../source/examples/notebooks/models/MPM.ipynb:1168
msgid ""
"One can choose from Fickian diffusion or a uniform concentration profile "
"within the particles. Teh default is \"Fickian diffusion\"."
msgstr ""

#: ../../../source/examples/notebooks/models/MPM.ipynb:-1
msgid "[19]:"
msgstr ""

#: ../../../source/examples/notebooks/models/MPM.ipynb:-1
msgid ""
"model_Fickian = pybamm.lithium_ion.MPM(name=\"MPM Fickian\")\n"
"model_Uniform = pybamm.lithium_ion.MPM(\n"
"    name=\"MPM Uniform\", options={\"particle\": \"uniform profile\"}\n"
")\n"
"\n"
