#: ../../../source/examples/notebooks/batch_study.ipynb:264
msgid "Comparing parameters"
msgstr ""

#: ../../../source/examples/notebooks/batch_study.ipynb:266
msgid ""
"``BatchStudy`` can also be used to compare different things (like affect of "
"changing a parameter's value) on a single model."
msgstr ""

#: ../../../source/examples/notebooks/batch_study.ipynb:268
msgid ""
"In the following cell, we compare different values of ``\"Curent function "
"[A]\"`` using the ``Single Paritcle Model with electrolyte``."
msgstr ""

#: ../../../source/examples/notebooks/batch_study.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/batch_study.ipynb:-1
msgid ""
"model = {\"spme\": spme}\n"
"\n"
"# populating a dictionary with 3 same parameter values\n"
"parameter_values = {\n"
"    \"Chen2020_1\": pybamm.ParameterValues(\"Chen2020\"),\n"
"    \"Chen2020_2\": pybamm.ParameterValues(\"Chen2020\"),\n"
"    \"Chen2020_3\": pybamm.ParameterValues(\"Chen2020\"),\n"
"}\n"
"\n"
"# different values for \"Current function [A]\"\n"
"current_values = [4.5, 4.75, 5]\n"
"\n"
"# changing the value of \"Current function [A]\" in all the parameter values "
"present in the\n"
"# parameter_values dictionary\n"
"for _, v, current_value in zip(\n"
"    parameter_values.keys(), parameter_values.values(), current_values, "
"strict=False\n"
"):\n"
"    v[\"Current function [A]\"] = current_value\n"
"\n"
"# creating a BatchStudy object with permutations set to True to create a "
"cartesian product\n"
"batch_study = pybamm.BatchStudy(\n"
"    models=model, parameter_values=parameter_values, permutations=True\n"
")\n"
"batch_study.solve(t_eval=[0, 3600])\n"
"\n"
"# generating the required labels and plotting\n"
"labels = [f\"Current function [A]: {current}\" for current in "
"current_values]\n"
"batch_study.plot(labels=labels)"
msgstr ""

