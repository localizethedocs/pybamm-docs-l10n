#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:623
msgid "Saving the solution"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:625
msgid "The solution can be saved in a number of ways:"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:-1
msgid "[14]:"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:-1
msgid ""
"# to a pickle file (default)\n"
"solution.save_data(\n"
"    \"outputs.pickle\",\n"
"    [\"Time [h]\", \"Current [A]\", \"Voltage [V]\", \"Electrolyte "
"concentration [mol.m-3]\"],\n"
")\n"
"# to a matlab file\n"
"# need to give variable names without space\n"
"solution.save_data(\n"
"    \"outputs.mat\",\n"
"    [\"Time [h]\", \"Current [A]\", \"Voltage [V]\", \"Electrolyte "
"concentration [mol.m-3]\"],\n"
"    to_format=\"matlab\",\n"
"    short_names={\n"
"        \"Time [h]\": \"t\",\n"
"        \"Current [A]\": \"I\",\n"
"        \"Voltage [V]\": \"V\",\n"
"        \"Electrolyte concentration [mol.m-3]\": \"c_e\",\n"
"    },\n"
")\n"
"# to a csv file (time-dependent outputs only, no spatial dependence "
"allowed)\n"
"solution.save_data(\n"
"    \"outputs.csv\", [\"Time [h]\", \"Current [A]\", \"Voltage [V]\"], "
"to_format=\"csv\"\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:668
msgid "Stepping the solver"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:670
msgid ""
"The previous solution was created in one go with the solve method, but it is "
"also possible to step the solution and look at the results as we go. In "
"doing so, the results are automatically updated at each step."
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:-1
msgid "[15]:"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:-1
msgid ""
"dt = 360\n"
"time = 0\n"
"end_time = solution[\"Time [s]\"].entries[-1]\n"
"step_simulation = pybamm.Simulation(model)\n"
"while time < end_time:\n"
"    step_solution = step_simulation.step(dt)\n"
"    print(\"Time\", time)\n"
"    print(step_solution[\"Voltage [V]\"].entries)\n"
"    time += dt"
msgstr ""

