#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:9
msgid "A look at solution data and processed variables"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:20
msgid ""
"Once you have run a simulation the first thing you want to do is have a look "
"at the data. Most of the examples so far have made use of PyBaMM's handy "
"QuickPlot function but there are other ways to access the data and this "
"notebook will explore them. First off we will generate a standard SPMe model "
"and use QuickPlot to view the default variables."
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/solution-data-and-processed-variables.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import os\n"
"\n"
"import matplotlib.pyplot as plt\n"
"import numpy as np\n"
"\n"
"import pybamm\n"
"\n"
"os.chdir(pybamm.__path__[0] + \"/..\")\n"
"\n"
"# load model\n"
"model = pybamm.lithium_ion.SPMe()\n"
"\n"
"# set up and solve simulation\n"
"simulation = pybamm.Simulation(model)\n"
"t = [0, 3600]\n"
"solution = simulation.solve(t)\n"
"\n"
"quick_plot = pybamm.QuickPlot(solution)\n"
"quick_plot.dynamic_plot();"
msgstr ""

