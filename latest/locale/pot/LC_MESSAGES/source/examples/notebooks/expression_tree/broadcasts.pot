msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import numpy as np\n"
"\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:35
msgid ""
"<pre>\n"
"Note: you may need to restart the kernel to use updated packages.\n"
"</pre>"
