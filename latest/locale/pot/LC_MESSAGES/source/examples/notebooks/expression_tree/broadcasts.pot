#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:59
msgid ""
"We also explicitly set up the discretisation that is used for this notebook. "
"We use a small number of points in each domain, in order to easily visualise "
"the results."
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid ""
"var = pybamm.standard_spatial_vars\n"
"geometry = {\n"
"    \"negative electrode\": {var.x_n: {\"min\": pybamm.Scalar(0), \"max\": "
"pybamm.Scalar(1)}},\n"
"    \"negative particle\": {var.r_n: {\"min\": pybamm.Scalar(0), \"max\": "
"pybamm.Scalar(1)}},\n"
"}\n"
"\n"
"submesh_types = {\n"
"    \"negative electrode\": pybamm.Uniform1DSubMesh,\n"
"    \"negative particle\": pybamm.Uniform1DSubMesh,\n"
"}\n"
"\n"
"var_pts = {var.x_n: 5, var.r_n: 3}\n"
"mesh = pybamm.Mesh(geometry, submesh_types, var_pts)\n"
"\n"
"spatial_methods = {\n"
"    \"negative electrode\": pybamm.FiniteVolume(),\n"
"    \"negative particle\": pybamm.FiniteVolume(),\n"
"}\n"
"disc = pybamm.Discretisation(mesh, spatial_methods)"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:99
msgid "Primary broadcasts"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:110
msgid ""
"Primary broadcasts are used to broadcast from a \"larger\" scale to a "
"\"smaller\" scale, for example broadcasting temperature T(x) from the "
"electrode to the particles, or broadcasting current collector current i(y, "
"z) from the current collector to the electrodes. To demonstrate this, we "
"first create a variable ``T`` on the negative electrode domain, discretise "
"it, and evaluate it with a simple linear vector"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid ""
"T = pybamm.Variable(\"T\", domain=\"negative electrode\")\n"
"disc.set_variable_slices([T])\n"
"disc_T = disc.process_symbol(T)\n"
"disc_T.evaluate(y=np.linspace(0, 1, 5))"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:135
msgid ""
"<pre>\n"
"array([[0.  ],\n"
"       [0.25],\n"
"       [0.5 ],\n"
"       [0.75],\n"
"       [1.  ]])\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:145
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
"array([[0.  ],\n"
"       [0.25],\n"
"       [0.5 ],\n"
"       [0.75],\n"
"       [1.  ]])\n"
"\\end{sphinxVerbatim}"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:156
msgid ""
"array([[0.  ],\n"
"       [0.25],\n"
"       [0.5 ],\n"
"       [0.75],\n"
"       [1.  ]])"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:171
msgid ""
"We then broadcast ``T`` onto the \"negative particle\" domain (using primary "
"broadcast as we are going from the larger electrode scale to the smaller "
"particle scale), and discretise and evaluate the resulting object."
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid "[4]:"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:-1
msgid ""
"primary_broad_T = pybamm.PrimaryBroadcast(T, \"negative particle\")\n"
"disc_T = disc.process_symbol(primary_broad_T)\n"
"disc_T.evaluate(y=np.linspace(0, 1, 5))"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:195
msgid ""
"<pre>\n"
"array([[0.  ],\n"
"       [0.  ],\n"
"       [0.  ],\n"
"       [0.25],\n"
"       [0.25],\n"
"       [0.25],\n"
"       [0.5 ],\n"
"       [0.5 ],\n"
"       [0.5 ],\n"
"       [0.75],\n"
"       [0.75],\n"
"       [0.75],\n"
"       [1.  ],\n"
"       [1.  ],\n"
"       [1.  ]])\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:215
msgid ""
