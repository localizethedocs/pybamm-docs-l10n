#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:9
msgid "Broadcasts"
msgstr ""

#: ../../../source/examples/notebooks/expression_tree/broadcasts.ipynb:11
msgid ""
"This notebook explains the different types of broadcast available in PyBaMM. "
"Understanding of the `expression_tree <./expression-tree.ipynb>`__ and "
"`discretisation <../spatial_methods/finite-volumes.ipynb>`__ notebooks is "
"assumed."
msgstr ""

