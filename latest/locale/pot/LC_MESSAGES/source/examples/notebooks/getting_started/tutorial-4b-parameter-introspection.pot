#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:338
msgid "3. Comparing Parameter Sets"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:340
msgid "Use ``diff()`` to compare two parameter sets and see what's different."
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid "[6]:"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid ""
"# Load another parameter set\n"
"chen = pybamm.ParameterValues(\"Chen2020\")\n"
"marquis = pybamm.ParameterValues(\"Marquis2019\")\n"
"\n"
"# Compare them\n"
"diff = chen.diff(marquis)\n"
"\n"
"print(f\"Parameters only in Chen2020: {len(diff.removed)}\")\n"
"print(f\"Parameters only in Marquis2019: {len(diff.added)}\")\n"
"print(f\"Parameters with different values: {len(diff.changed)}\")"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:370
msgid ""
"<pre>\n"
"Parameters only in Chen2020: 1\n"
"Parameters only in Marquis2019: 12\n"
"Parameters with different values: 46\n"
"</pre>"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:378
msgid ""
"\\begin{sphinxVerbatim}[commandchars=\\\\\\{\\}]\n"
