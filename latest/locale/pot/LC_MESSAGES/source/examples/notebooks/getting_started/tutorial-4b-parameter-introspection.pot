#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:113
msgid "2. Browsing Parameters by Category"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:115
msgid ""
"Use ``list_by_category()`` to find all parameters in a specific category, or "
"``categories()`` to see all parameters grouped by category."
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid "[3]:"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid ""
"# List all negative electrode parameters\n"
"neg_electrode_params = params.list_by_category(\"negative electrode\")\n"
"print(f\"Found {len(neg_electrode_params)} negative electrode parameters:"
"\")\n"
"for p in neg_electrode_params[:5]:  # Show first 5\n"
"    print(f\"  - {p}\")\n"
"print(\"  ...\")"
msgstr ""

