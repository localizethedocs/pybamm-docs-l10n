#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:9
msgid "Tutorial 4b: Parameter Introspection and Comparison"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:11
msgid ""
"This tutorial introduces the parameter introspection features in PyBaMM's "
"``ParameterValues`` class. These features help you:"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:13
msgid "**Understand parameters** - Get metadata like units and categories"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:14
msgid ""
"**Browse by category** - Find parameters related to electrodes, thermal, etc."
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:15
msgid "**Compare parameter sets** - See differences between parameter sets"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid ""
"import pybamm\n"
"\n"
"pybamm.set_logging_level(\"WARNING\")"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:39
msgid "1. Getting Parameter Information"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:41
msgid ""
"The ``get_info()`` method returns metadata about a parameter including its "
"value, units, and category."
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:-1
msgid ""
"# Load the Chen2020 parameter set\n"
"params = pybamm.ParameterValues(\"Chen2020\")\n"
"\n"
"# Get information about a specific parameter\n"
"info = params.get_info(\"Maximum concentration in negative electrode [mol."
"m-3]\")\n"
"\n"
"print(f\"Parameter: {info.name}\")\n"
"print(f\"Value: {info.value}\")\n"
"print(f\"Units: {info.units}\")\n"
"print(f\"Category: {info.category}\")\n"
"print(f\"Is function: {info.is_function}\")\n"
"print(f\"Is input parameter: {info.is_input}\")"
msgstr ""

#: ../../../source/examples/notebooks/getting_started/tutorial-4b-parameter-introspection.ipynb:73
msgid ""
"<pre>\n"
"Parameter: Maximum concentration in negative electrode [mol.m-3]\n"
"Value: 33133.0\n"
"Units: mol.m-3\n"
"Category: negative electrode\n"
"Is function: False\n"
"Is input parameter: False\n"
"</pre>"
msgstr ""

