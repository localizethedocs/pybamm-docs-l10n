msgid "[2]:"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/simulation-class.ipynb:-1
msgid ""
"model = pybamm.lithium_ion.SPM()\n"
"simulation = pybamm.Simulation(model)"
msgstr ""

