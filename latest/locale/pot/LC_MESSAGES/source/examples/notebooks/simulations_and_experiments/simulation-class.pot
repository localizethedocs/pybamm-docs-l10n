msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import pybamm"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/simulation-class.ipynb:37
msgid "Simulation"
msgstr ""

#: ../../../source/examples/notebooks/simulations_and_experiments/simulation-class.ipynb:39
msgid ""
"The easiest way to get started is to pick a model and create a simulation "
"using that model. For simplicity, we'll use the SPM with all the default "
"options here."
msgstr ""

