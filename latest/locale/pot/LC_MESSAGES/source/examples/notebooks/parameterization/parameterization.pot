"from pybamm import constants, exp\n"
"\n"
"\n"
"def graphite_LGM50_electrolyte_exchange_current_density_Chen2020(\n"
"    c_e, c_s_surf, c_n_max, T\n"
"):\n"
"    m_ref = 6.48e-7  # (A/m2)(m3/mol)**1.5 - includes ref concentrations\n"
"    E_r = 35000\n"
"    arrhenius = exp(E_r / constants.R * (1 / 298.15 - 1 / T))\n"
"\n"
"    return m_ref * arrhenius * c_e**0.5 * c_s_surf**0.5 * (c_n_max - "
"c_s_surf) ** 0.5\n"
"\n"
"\n"
"def nmc_LGM50_electrolyte_exchange_current_density_Chen2020(c_e, c_s_surf, "
"c_p_max, T):\n"
"    m_ref = 3.42e-6  # (A/m2)(m3/mol)**1.5 - includes ref concentrations\n"
"    E_r = 17800\n"
"    arrhenius = exp(E_r / constants.R * (1 / 298.15 - 1 / T))\n"
"\n"
"    return m_ref * arrhenius * c_e**0.5 * c_s_surf**0.5 * (c_p_max - "
"c_s_surf) ** 0.5\n"
"\n"
