#: ../../../source/examples/notebooks/parameterization/parameter-values.ipynb:647
msgid "Printing parameter values"
msgstr ""

#: ../../../source/examples/notebooks/parameterization/parameter-values.ipynb:649
msgid ""
"Since parameters objects must be processed by the ``ParameterValues`` class "
"before they can be evaluated, it can be difficult to quickly check the value "
"of a parameter that is a combination of other parameters. You can print all "
"of the parameters (including combinations) in a model by using the "
"``print_parameters`` function."
msgstr ""

#: ../../../source/examples/notebooks/parameterization/parameter-values.ipynb:-1
msgid "[13]:"
msgstr ""

#: ../../../source/examples/notebooks/parameterization/parameter-values.ipynb:-1
msgid ""
"a = pybamm.Parameter(\"a\")\n"
"b = pybamm.Parameter(\"b\")\n"
"parameter_values = pybamm.ParameterValues({\"a\": 4, \"b\": 3})\n"
"parameters = {\"a\": a, \"b\": b, \"a + b\": a + b, \"a * b\": a * b}\n"
"param_eval = parameter_values.print_parameters(parameters)\n"
"for name, value in param_eval.items():\n"
"    print(f\"{name}: {value}\")"
msgstr ""

#: ../../../source/examples/notebooks/parameterization/parameter-values.ipynb:676
msgid ""
