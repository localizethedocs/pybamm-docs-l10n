"        borderaxespad=0.0,\n"
"        ncol=3,\n"
"        mode=\"expand\",\n"
"    )\n"
"\n"
"    ax[0, 1].legend(\n"
"        [comsol_p, pybamm_p, dfncc_p],\n"
"        [\"COMSOL\", r\"$1+1$D\", \"DFNCC\"],\n"
"        bbox_to_anchor=(0, 1.5, 1.0, 0.102),\n"
"        loc=\"lower left\",\n"
"        borderaxespad=0.0,\n"
"        ncol=3,\n"
"        mode=\"expand\",\n"
"    )\n"
