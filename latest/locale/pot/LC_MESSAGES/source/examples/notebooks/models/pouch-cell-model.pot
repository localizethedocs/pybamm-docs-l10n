#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:629
msgid "We then set up the times and points in space to use in the plots"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid "[14]:"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid ""
"t_plot = comsol_t\n"
"z_plot = z_interp\n"
"t_slices = np.array([600, 1200, 1800, 2400, 3000]) / 3"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:652
msgid "and plot the negative current collector potential"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid "[15]:"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid ""
"var = \"Negative current collector potential [V]\"\n"
"comsol_var_fun = comsol_solution[var]\n"
"dfn_var_fun = solutions[\"1+1D DFN\"][var]\n"
"\n"
"dfncc_var_fun = dfncc_vars[var]\n"
"plot(\n"
"    t_plot,\n"
"    z_plot,\n"
"    t_slices,\n"
"    r\"$\\phi^*_{\\mathrm{s,cn}}$\",\n"
"    \"[V]\",\n"
"    comsol_var_fun,\n"
"    dfn_var_fun,\n"
"    dfncc_var_fun,\n"
"    param,\n"
"    cmap=\"cividis\",\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:697
msgid "the positive current collector potential with respect to voltage"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid "[16]:"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid ""
"var = \"Positive current collector potential [V]\"\n"
"comsol_var = comsol_solution[var]\n"
"V_comsol = comsol_solution[\"Voltage [V]\"]\n"
"\n"
"\n"
"def comsol_var_fun(t, z):\n"
"    return comsol_var(t=t, z=z) - V_comsol(t=t)\n"
"\n"
"\n"
"dfn_var = solutions[\"1+1D DFN\"][var]\n"
"V = solutions[\"1+1D DFN\"][\"Voltage [V]\"]\n"
"\n"
"\n"
"def dfn_var_fun(t, z):\n"
"    return dfn_var(t=t, z=z) - V(t=t)\n"
"\n"
"\n"
"dfncc_var = dfncc_vars[var]\n"
"V_dfncc = dfncc_vars[\"Voltage [V]\"]\n"
"\n"
"\n"
"def dfncc_var_fun(t, z):\n"
"    return dfncc_var(t=t, z=z) - V_dfncc(t)\n"
"\n"
"\n"
"plot(\n"
"    t_plot,\n"
"    z_plot,\n"
"    t_slices,\n"
"    r\"$\\phi^*_{\\mathrm{s,cp}} - V^*$\",\n"
"    \"[V]\",\n"
"    comsol_var_fun,\n"
"    dfn_var_fun,\n"
"    dfncc_var_fun,\n"
"    param,\n"
"    cmap=\"viridis\",\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:762
msgid "the through-cell current"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid "[17]:"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid ""
"var = \"Current collector current density [A.m-2]\"\n"
"comsol_var_fun = comsol_solution[var]\n"
"dfn_var_fun = solutions[\"1+1D DFN\"][var]\n"
"\n"
"I_av = solutions[\"Average DFN\"][var]\n"
"\n"
"\n"
"def dfncc_var_fun(t, z):\n"
"    \"In the DFNCC the current is just the average current\"\n"
"    return np.transpose(np.repeat(I_av(t)[:, np.newaxis], len(z), axis=1))\n"
"\n"
"\n"
"plot(\n"
"    t_plot,\n"
"    z_plot,\n"
"    t_slices,\n"
"    r\"$\\mathcal{I}^*$\",\n"
"    \"[A/m${}^2$]\",\n"
"    comsol_var_fun,\n"
"    dfn_var_fun,\n"
"    dfncc_var_fun,\n"
"    param,\n"
"    cmap=\"plasma\",\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:814
msgid "and the temperature with respect to reference temperature"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid "[18]:"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:-1
msgid ""
"T_ref = param.evaluate(dfn.param.T_ref)\n"
"var = \"X-averaged cell temperature [K]\"\n"
"comsol_var = comsol_solution[var]\n"
"\n"
"\n"
"def comsol_var_fun(t, z):\n"
"    return comsol_var(t=t, z=z) - T_ref\n"
"\n"
"\n"
"dfn_var = solutions[\"1+1D DFN\"][var]\n"
"\n"
"\n"
"def dfn_var_fun(t, z):\n"
"    return dfn_var(t=t, z=z) - T_ref\n"
"\n"
"\n"
"T_av = solutions[\"Average DFN\"][var]\n"
"\n"
"\n"
"def dfncc_var_fun(t, z):\n"
"    \"In the DFNCC the temperature is just the average temperature\"\n"
"    return np.transpose(np.repeat(T_av(t)[:, np.newaxis], len(z), axis=1)) - "
"T_ref\n"
"\n"
"\n"
"plot(\n"
"    t_plot,\n"
"    z_plot,\n"
"    t_slices,\n"
"    \"$\\\\bar{T}^* - \\\\bar{T}_0^*$\",\n"
"    \"[K]\",\n"
"    comsol_var_fun,\n"
"    dfn_var_fun,\n"
"    dfncc_var_fun,\n"
"    param,\n"
"    cmap=\"inferno\",\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:878
msgid ""
"We see that the electrical conductivity of the current collectors is "
"sufficiently high that the potentials remain fairly uniform in space, and "
"both the 1+1D DFN and DFNCC models are able to accurately capture the "
"potential distribution in the current collectors."
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:880
msgid ""
"In the plot of the current we see that positioning both tabs at the top of "
"the cell means that for most of the simulation the current preferentially "
"travels through the upper part of the cell. Eventually, as the cell "
"continues to discharge, this part becomes more (de)lithiated until the "
"resultant local increase in through-cell resistance is sufficient for it to "
"become preferential for the current to travel further along the current "
"collectors and through the lower part of the cell. This behaviour is well "
"captured by the 1+1D model. In the DFNCC formulation the through-cell "
"current density is assumed uniform, so the greatest error is found at the "
"ends of the current collectors where the current density deviates most from "
"its average."
msgstr ""

#: ../../../source/examples/notebooks/models/pouch-cell-model.ipynb:883
msgid ""
"For the parameters used in this example we find that the temperature "
"exhibits a relatively weak variation along the length of the current "
"collectors."
msgstr ""

