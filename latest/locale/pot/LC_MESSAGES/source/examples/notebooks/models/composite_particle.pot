#: ../../../source/examples/notebooks/models/composite_particle.ipynb:9
msgid "A composite electrode particle model"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:20
msgid ""
"A composite electrode particle model is developed for (negative) electrodes "
"with two phases, e.g. graphite/silicon in LG M50 battery cells. The current "
"version is demonstrated for negative composite electrodes only but is easily "
"extended to positive composite electrodes. The reference is at the end of "
"this notebook."
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:32
msgid "How to use the model"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:34
msgid "Let us set up PyBaMM"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid "[30]:"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid ""
"# %pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import os\n"
"import timeit\n"
"\n"
"import matplotlib.pyplot as plt\n"
"from matplotlib import style\n"
"\n"
"import pybamm\n"
"\n"
"style.use(\"ggplot\")\n"
"os.chdir(pybamm.__path__[0] + \"/..\")"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:65
msgid ""
"Choose the option ``{\"particle phases\": (\"2\", \"1\")}`` to load the "
"composite electrode particle model by specifying that there are two particle "
"phases (graphite and silicon) in the negative electrode. The parameter set "
"\"Chen2020_composite\" includes parameters for silicon as a secondary "
"particle"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid "[31]:"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid ""
"start = timeit.default_timer()\n"
"model = pybamm.lithium_ion.DFN(\n"
"    {\n"
"        \"particle phases\": (\"2\", \"1\"),\n"
"        \"open-circuit potential\": ((\"single\", \"current sigmoid\"), "
"\"single\"),\n"
"    }\n"
")\n"
"param = pybamm.ParameterValues(\"Chen2020_composite\")\n"
"\n"
"param.update({\"Upper voltage cut-off [V]\": 4.5})\n"
"param.update({\"Lower voltage cut-off [V]\": 2.5})\n"
"\n"
"param.update(\n"
"    {\n"
"        \"Primary: Maximum concentration in negative electrode [mol.m-3]\": "
"28700,\n"
"        \"Primary: Initial concentration in negative electrode [mol.m-3]\": "
"23000,\n"
"        \"Primary: Negative particle diffusivity [m2.s-1]\": 5.5e-14,\n"
"        \"Secondary: Negative particle diffusivity [m2.s-1]\": 1.67e-14,\n"
"        \"Secondary: Initial concentration in negative electrode [mol."
"m-3]\": 277000,\n"
"        \"Secondary: Maximum concentration in negative electrode [mol."
"m-3]\": 278000,\n"
"    }\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:108
msgid "Single Cycle Simulations"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:119
msgid "Define a current loading"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid "[32]:"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid ""
"C_rate = 0.5\n"
"capacity = param[\"Nominal cell capacity [A.h]\"]\n"
"I_load = C_rate * capacity\n"
"\n"
"t_eval = [0, 10000]\n"
"\n"
"param[\"Current function [A]\"] = I_load"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:146
msgid ""
"It is very easy to vary the relative volume fraction of each phase. The "
"following example shows how to compare the results of batteries with three "
"relative volume fractions (0.001, 0.04, 0.1) of silicon."
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid "[33]:"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid ""
"v_si = [0.001, 0.04, 0.1]\n"
"total_am_volume_fraction = 0.75\n"
"solution = []\n"
"for v in v_si:\n"
"    param.update(\n"
"        {\n"
"            \"Primary: Negative electrode active material volume fraction\": "
"(1 - v)\n"
"            * total_am_volume_fraction,  # primary\n"
"            \"Secondary: Negative electrode active material volume "
"fraction\": v\n"
"            * total_am_volume_fraction,\n"
"        }\n"
"    )\n"
"    print(v)\n"
"    sim = pybamm.Simulation(\n"
"        model,\n"
"        parameter_values=param,\n"
"    )\n"
"    solution.append(sim.solve(t_eval=t_eval))\n"
"stop = timeit.default_timer()\n"
"print(\"running time: \" + str(stop - start) + \"s\")"
msgstr ""

