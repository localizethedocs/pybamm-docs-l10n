#: ../../../source/examples/notebooks/models/composite_particle.ipynb:692
msgid "Multi-Cycle Simulations"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:694
msgid ""
"For multi-cycling, an experiment definition for static C/2 discharge and "
"charge cycling is presented."
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid "[40]:"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid ""
"experiment = pybamm.Experiment(\n"
"    [\n"
"        (\n"
"            \"Discharge at C/2 until 3.0 V\",\n"
"            \"Rest for 1 hour\",\n"
"            \"Charge at C/2 until 4.2 V\",\n"
"            \"Rest for 1 hour\",\n"
"        ),\n"
"    ]\n"
"    * 2\n"
")"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:725
msgid ""
"The solution is reintroduced, with ``calc_esoh=False`` passed into the solve "
"function. Currently, composite electrode state of health predictions are not "
"included in this model."
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid "[41]:"
msgstr ""

#: ../../../source/examples/notebooks/models/composite_particle.ipynb:-1
msgid ""
"solution = []\n"
"for v in v_si:\n"
"    param.update(\n"
"        {\n"
"            \"Primary: Negative electrode active material volume fraction\": "
"(1 - v)\n"
"            * total_am_volume_fraction,  # primary\n"
"            \"Secondary: Negative electrode active material volume "
"fraction\": v\n"
"            * total_am_volume_fraction,\n"
"        }\n"
"    )\n"
"    print(v)\n"
"    sim = pybamm.Simulation(\n"
"        model,\n"
"        experiment=experiment,\n"
"        parameter_values=param,\n"
"    )\n"
"    solution.append(sim.solve(calc_esoh=False))\n"
"stop = timeit.default_timer()\n"
"print(\"running time: \" + str(stop - start) + \"s\")"
msgstr ""

