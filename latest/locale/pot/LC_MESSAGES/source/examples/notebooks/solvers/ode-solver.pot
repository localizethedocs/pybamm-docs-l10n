msgstr ""

#: ../../../source/examples/notebooks/solvers/ode-solver.ipynb:11
msgid ""
"In this notebook, we show some examples of solving an ODE model. For the "
"purposes of this example, we use the Scipy solver, but the syntax remains "
"the same for other solvers"
msgstr ""

#: ../../../source/examples/notebooks/solvers/ode-solver.ipynb:-1
msgid "[1]:"
msgstr ""

#: ../../../source/examples/notebooks/solvers/ode-solver.ipynb:-1
msgid ""
"%pip install \"pybamm[plot,cite]\" -q    # install PyBaMM if it is not "
"installed\n"
"import os\n"
"\n"
