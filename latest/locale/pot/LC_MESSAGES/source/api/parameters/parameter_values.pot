#: ../../../source/api/parameters/parameter_values.rst:2
msgid "Parameter Values"
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:4
msgid ""
"The ``ParameterValues`` class is the main interface for managing battery "
"simulation parameters. It provides methods for storing, updating, and "
"processing parameters, as well as introspection features for exploring "
"parameter sets."
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:9
msgid "Features"
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:11
msgid "The ``ParameterValues`` class now includes several helpful features:"
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:13
msgid ""
"**Parameter Introspection**: Use :meth:`get_info` to get metadata about "
"parameters including units and category."
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:15
msgid ""
"**Category Browsing**: Use :meth:`list_by_category` to find parameters by "
"domain (e.g., \"negative electrode\", \"thermal\")."
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:17
msgid ""
"**Parameter Comparison**: Use :meth:`diff` to compare two parameter sets and "
"see what's added, removed, or changed."
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:20
msgid "Example usage::"
msgstr ""

#: ../../../source/api/parameters/parameter_values.rst:22
msgid ""
"import pybamm\n"
"\n"
"# Load a parameter set\n"
"params = pybamm.ParameterValues(\"Chen2020\")\n"
"\n"
"# Get info about a parameter\n"
"info = params.get_info(\"Maximum concentration in negative electrode [mol."
"m-3]\")\n"
"print(f\"Value: {info.value}, Units: {info.units}, Category: {info."
"category}\")\n"
"\n"
"# List parameters by category\n"
"neg_electrode_params = params.list_by_category(\"negative electrode\")\n"
"print(f\"Found {len(neg_electrode_params)} negative electrode parameters\")\n"
"\n"
"# Compare with another parameter set\n"
"marquis = pybamm.ParameterValues(\"Marquis2019\")\n"
"diff = params.diff(marquis)\n"
"print(f\"Changed parameters: {list(diff.changed.keys())[:5]}\")"
msgstr ""

