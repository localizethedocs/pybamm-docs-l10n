msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/parameters/process_parameter_data.py:docstring
#: of pybamm.parameters.process_parameter_data.process_2D_data_csv:14
#: pybamm.parameters.process_parameter_data.process_3D_data_csv:14
msgid "The path to the file where the three dimensional data is stored."
msgstr ""

#: ../../../source/api/parameters/process_parameter_data.rst:0
msgid "Returns"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/parameters/process_parameter_data.py:docstring
