msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/parameters/process_parameter_data.py:docstring
#: of pybamm.parameters.process_parameter_data.process_2D_data:1
msgid "Process 2D data from a JSON file"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/parameters/process_parameter_data.py:docstring
#: of pybamm.parameters.process_parameter_data.process_2D_data_csv:1
msgid ""
"Process 2D data from a csv file. Assumes data is in the form of a three "
"columns and that all data points lie on a regular grid. The first column is "
"assumed to be the 'slowest' changing variable and the second column the "
"'fastest' changing variable, which is the C convention for indexing "
"multidimensional arrays (as opposed to the Fortran convention where the "
"'fastest' changing variable comes first)."
msgstr ""

