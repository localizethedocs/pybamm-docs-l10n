#: ../../../source/api/models/submodels/interface/kinetics/coupled_ion_electron_transfer.rst:2
msgid "Coupled ion-electron transfer"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/interface/kinetics/coupled_ion_electron_transfer.py:docstring
#: of
#: pybamm.models.submodels.interface.kinetics.coupled_ion_electron_transfer.CoupledIonElectronTransfer:1
msgid ""
"Intercalation rate law in which the ion and electron transfer in one "
"concerted step :footcite:t:`Fraggedakis2021`, using the asymptotic Marcus-"
"Hush-Chidsey integral of :footcite:t:`Zeng2014`. In units of :math:`RT/F`,"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/interface/kinetics/coupled_ion_electron_transfer.py:docstring
#: of
#: pybamm.models.submodels.interface.kinetics.coupled_ion_electron_transfer.CoupledIonElectronTransfer:5
msgid ""
"j = k_0 \\sqrt{\\pi\\lambda}\\,\\mathrm{erfc}\\left(\\frac{\\lambda - "
"\\sqrt{1 + \\sqrt{\\lambda} + \\eta_f^2}}{2\\sqrt{\\lambda}}\\right) (1 - "
"\\theta) \\left[\\frac{\\theta}{1 + e^{-\\eta_f}} - \\frac{\\tilde{c}_e}{1 + "
"e^{\\eta_f}}\\right],\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/interface/kinetics/coupled_ion_electron_transfer.py:docstring
#: of
#: pybamm.models.submodels.interface.kinetics.coupled_ion_electron_transfer.CoupledIonElectronTransfer:8
msgid ""
"where :math:`\\eta_f = \\eta_r + \\ln(\\tilde{c}_e / "
"\\theta)`, :math:`\\theta = c_{s,surf}/c_{max}` and :math:`\\tilde{c}_e = "
"c_e/c_{e,init}`. Not available for a lithium metal electrode, which has no "
"host lattice."
msgstr ""

