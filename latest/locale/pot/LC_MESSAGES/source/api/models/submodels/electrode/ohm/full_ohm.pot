#: ../../../source/api/models/submodels/electrode/ohm/full_ohm.rst:2
msgid "Full Model"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:1
msgid ""
"This submodel implements Ohm's law for electrodes, accounting for full "
"resistance effects."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:3
msgid ""
"The model solves for the electrode potential distribution using the "
"effective conductivity, which is the product of the material conductivity "
"and the transport efficiency."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:6
msgid ""
"\\nabla \\cdot (\\sigma_{  ext{eff}} \\nabla \\phi_s) = -a_j\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:9
msgid "where:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:10
msgid ""
":math:`\\sigma_{       ext{eff}} = \\sigma \\cdot \\tau_{ ext{or}}` is the "
"effective conductivity"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:11
msgid ":math:`\\phi_s` is the electrode potential"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:12
msgid ":math:`a_j` is the volumetric interfacial current density"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:14
msgid ""
"**Extends:** :class:`pybamm.models.submodels.electrode.ohm.base_ohm."
"BaseModel`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full:0
msgid "View inheritance diagram for this model"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.get_coupled_variables:1
msgid ""
"A public method that creates and returns the variables in a submodel which "
"require variables in other submodels to be set first. For example, the "
"exchange current density requires the concentration in the electrolyte to be "
"created before it can be created. If a variable can be created independent "
"of other submodels then it should be created in 'get_fundamental_variables' "
"instead of this method."
msgstr ""

#: ../../../source/api/models/submodels/electrode/ohm/full_ohm.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.get_coupled_variables:8
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.set_algebraic:6
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.set_boundary_conditions:6
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.set_initial_conditions:7
msgid "The variables in the whole model."
msgstr ""

#: ../../../source/api/models/submodels/electrode/ohm/full_ohm.rst:0
msgid "Returns"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.get_coupled_variables:11
msgid ""
"The variables created in this submodel which depend on variables in other "
"submodels."
msgstr ""

#: ../../../source/api/models/submodels/electrode/ohm/full_ohm.rst:0
msgid "Return type"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.get_fundamental_variables:1
msgid ""
"A public method that creates and returns the variables in a submodel which "
"can be created independent of other submodels. For example, the electrolyte "
"concentration variables can be created independent of whether any other "
"variables have been defined in the model. As a rule, if a variable can be "
"created without variables from other submodels, then it should be placed in "
"this method."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.get_fundamental_variables:8
msgid ""
"The variables created by the submodel which are independent of variables in "
"other submodels."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of pybamm.models.submodels.electrode.ohm.full_ohm.Full.set_algebraic:1
msgid ""
"A method to set the differential equations which do not contain a time "
"derivative. Note: this method modifies the state of self.algebraic. Unless "
"overwritten by a submodel, the default behaviour of 'pass' is used as "
"implemented in :class:`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.set_boundary_conditions:1
msgid ""
"A method to set the boundary conditions for the submodel. Note: this method "
"modifies the state of self.boundary_conditions. Unless overwritten by a "
"submodel, the default behaviour of 'pass' is used as implemented in :class:"
"`pybamm.BaseSubModel`."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/models/submodels/electrode/ohm/full_ohm.py:docstring
#: of
#: pybamm.models.submodels.electrode.ohm.full_ohm.Full.set_initial_conditions:1
msgid ""
"A method to set the initial conditions for the submodel. Note: this method "
"modifies the state of self.initial_conditions. Unless overwritten by a "
"submodel, the default behaviour of 'pass' is used as implemented in :class:"
"`pybamm.BaseSubModel`."
msgstr ""
