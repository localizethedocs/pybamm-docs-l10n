#: ../../../source/api/models/submodels/external_circuit/index.rst:2
msgid "External circuit"
msgstr ""

#: ../../../source/api/models/submodels/external_circuit/index.rst:4
msgid ""
"Models to enforce different boundary conditions (as imposed by an imaginary "
"external circuit) such as constant current, constant voltage, constant "
"power, or any other relationship between the current and voltage. \"Current "
"control\" enforces these directly through boundary conditions, while "
"\"Function control\" submodels add an algebraic equation (for the current) "
"and hence can be used to set any variable to be constant."
msgstr ""
