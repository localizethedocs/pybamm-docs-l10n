#: ../../../source/api/plotting/quick_plot.rst:4
msgid "Quick Plot"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:1
msgid ""
"Generates a quick plot of a subset of key outputs of the model so that the "
"model outputs can be easily assessed."
msgstr ""

#: ../../../source/api/plotting/quick_plot.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:4
msgid ""
"The numerical solution(s) for the model(s), or the simulation object(s) "
"containing the solution(s)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:7
msgid "List of variables to plot"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:9
msgid "Labels for the different models. Defaults to model names"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:11
msgid ""
"The colors to loop over when plotting. Defaults to None, in which case the "
"default color loop defined by matplotlib style sheet or rcParams is used."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:14
msgid ""
"The linestyles to loop over when plotting. Defaults to [\"-\", \":\", \"--"
"\", \"-.\"]"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:16
msgid "The shading to use for 2D plots. Defaults to \"auto\"."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:18
msgid "The size of the figure to make"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:20
msgid ""
"The number of rows to use. If None (default), floor(n // sqrt(n)) is used "
"where n = len(output_variables) so that the plot is as square as possible"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:23
msgid "Format for the time output (\"hours\", \"minutes\", or \"seconds\")"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:25
msgid "Format for the spatial axes (\"m\", \"mm\", or \"um\")"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:27
msgid ""
"How to set the axis limits (for 0D or 1D variables) or colorbar limits (for "
"2D variables). Options are:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:30
msgid ""
"The number of linearly spaced time points added to the t axis for each sub-"
"solution. Note: this is only used if the solution has hermite interpolation "
"enabled.  - \"fixed\" (default): keep all axes fixes so that all data is "
"visible - \"tight\": make axes tight to plot at each time - dictionary: fine-"
"grain control for each variable, can be either \"fixed\" or         "
"\"tight\" or a specific tuple (lower, upper)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:30
msgid ""
"The number of linearly spaced time points added to the t axis for each sub-"
"solution. Note: this is only used if the solution has hermite interpolation "
"enabled."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:33
msgid "\"fixed\" (default): keep all axes fixes so that all data is visible"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:34
msgid "\"tight\": make axes tight to plot at each time"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot:35
msgid ""
"dictionary: fine-grain control for each variable, can be either \"fixed\" "
"or         \"tight\" or a specific tuple (lower, upper)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.create_gif:1
msgid ""
"Generates x plots over a time span of max_t - min_t and compiles them to "
"create a GIF."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.create_gif:4
msgid "Number of images/plots to be compiled for a GIF."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.create_gif:6
msgid "Duration of visibility of a single image/plot in the created GIF."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.create_gif:8
msgid "Name of the generated GIF file."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.dynamic_plot:1
msgid "Generate a dynamic plot with a slider to control the time."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.dynamic_plot:3
msgid ""
"For notebook mode, size of steps to allow in the slider. Defaults to 1/100th "
"of the total time."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.dynamic_plot:6
msgid ""
"Whether to show the plots. Default is True. Set to False if you want to only "
"display the plot after plt.show() has been called."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.plot:1
msgid "Produces a quick plot with the internal states at time t."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.plot:3
msgid "Dimensional time (in 'time_units') at which to plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.plot:5
msgid ""
"Determine whether to allocate space for a slider at the bottom of the plot "
"when generating a dynamic plot. If True, creates a dynamic plot with a "
"slider."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.reset_axis:1
msgid ""
"Reset the axis limits to the default values. These are calculated to fit "
"around the minimum and maximum values of all the variables in each subplot"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/quick_plot.py:docstring
#: of pybamm.plotting.quick_plot.QuickPlot.slider_update:1
msgid "Update the plot in self.plot() with values at new time"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/dynamic_plot.py:docstring
#: of pybamm.plotting.dynamic_plot.dynamic_plot:1
msgid ""
"Creates a :class:`pybamm.QuickPlot` object (with arguments 'args' and "
"keyword arguments 'kwargs') and then calls :meth:`pybamm.QuickPlot."
"dynamic_plot`. The key-word argument 'show_plot' is passed to the "
"'dynamic_plot' method, not the `QuickPlot` class."
msgstr ""

