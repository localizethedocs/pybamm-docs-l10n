msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:1
msgid "Interactive VTK visualization for unstructured mesh solutions."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:3
msgid "Supports spatial (unstructured 2D/3D) and 0D (time-series) variables."
msgstr ""

#: ../../../source/api/plotting/plot_vtk.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:5
msgid "The solution to plot; a single-element list is also accepted."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:7
msgid ""
"Variables to plot. Defaults to the model's default quick-plot variables that "
"are 0D or live on an unstructured mesh."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:10
msgid ""
"Per-variable options keyed by variable name.  Each value is a dict that may "
"contain:  - ``\"plot_type\"``: ``\"3d\"`` (default) or ``\"slice\"`` - "
"``\"x\"`` / ``\"y\"`` / ``\"z\"``: float in [0, 1] giving the slice   "
"position as a fraction of the axis range (required when   ``plot_type`` is "
"``\"slice\"``) - ``\"scale\"``: ``\"auto\"`` (default), ``None``, or ``(sx, "
"sy, sz)``  A variable's value may also be a **list** of such dicts, in which "
"case one panel is created per entry::      options={\"T\": "
"[         {\"plot_type\": \"3d\"},         {\"plot_type\": \"slice\", \"x\": "
"0.5},     ]}"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:10
msgid ""
"Per-variable options keyed by variable name.  Each value is a dict that may "
"contain:"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:13
msgid "``\"plot_type\"``: ``\"3d\"`` (default) or ``\"slice\"``"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:14
msgid ""
"``\"x\"`` / ``\"y\"`` / ``\"z\"``: float in [0, 1] giving the slice position "
"as a fraction of the axis range (required when ``plot_type`` is "
"``\"slice\"``)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:17
msgid "``\"scale\"``: ``\"auto\"`` (default), ``None``, or ``(sx, sy, sz)``"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:19
msgid ""
"A variable's value may also be a **list** of such dicts, in which case one "
"panel is created per entry::"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:22
msgid ""
"options={\"T\": [\n"
"    {\"plot_type\": \"3d\"},\n"
"    {\"plot_type\": \"slice\", \"x\": 0.5},\n"
"]}"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot:27
msgid ""
"Evaluate the variables at the exact slider time instead of snapping to the "
"nearest stored solution time. Default is False."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/plotting/plot_vtk.py:docstring
#: of pybamm.plotting.plot_vtk.VTKQuickPlot.dynamic_plot:1
msgid "Launch an interactive VTK window with a time slider."
msgstr ""

