#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.boundary_mass_matrix:1
msgid ""
"Calculates the mass matrix for the finite element method assembled over the "
"boundary."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.boundary_value_or_flux:1
msgid ""
"Returns the average value of the symbol over the negative tab (\"negative "
"tab\") or the positive tab (\"positive tab\") in the Finite Element Method."
msgstr ""

