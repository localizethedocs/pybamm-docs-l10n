"Matrix for finite-element implementation of the definite integral over the "
"entire domain"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.definite_integral_matrix:4
msgid ""
"I = \\int_{\\Omega}\\!f(s)\\,dx\n"
"\n"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.definite_integral_matrix:7
