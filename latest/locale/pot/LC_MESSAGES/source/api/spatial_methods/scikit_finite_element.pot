#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.definite_integral_matrix:9
msgid "The symbol being integrated"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.definite_integral_matrix:11
msgid "Whether to return a row or column vector (default is row)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.divergence:1
msgid ""
"Matrix-vector multiplication to implement the divergence operator. See :meth:"
"`pybamm.SpatialMethod.divergence`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.gradient:1
msgid ""
"Matrix-vector multiplication to implement the gradient operator. The "
"gradient w of the function u is approximated by the finite element method "
"using the same function space as u, i.e. we solve w = grad(u), which "
"corresponds to the weak form w*v*dx = grad(u)*v*dx, where v is a suitable "
"test function."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.gradient:7
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.laplacian:3
msgid "The symbol that we will take the Laplacian of."
msgstr ""

