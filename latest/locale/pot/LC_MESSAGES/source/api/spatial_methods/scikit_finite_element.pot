#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.gradient:15
msgid ""
"A concatenation that contains the result of acting the discretised gradient "
"on the child discretised_symbol. The first column corresponds to the y-"
"component of the gradient and the second column corresponds to the z "
"component of the gradient."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/spatial_methods/scikit_finite_element.py:docstring
#: of
#: pybamm.spatial_methods.scikit_finite_element.ScikitFiniteElement.gradient:19
