msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of pybamm.discretisations.discretisation.Discretisation.process_symbol:8
msgid ":class:`pybamm.expression_tree.symbol.Symbol`"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of
#: pybamm.discretisations.discretisation.Discretisation.set_internal_boundary_conditions:1
msgid ""
"A method to set the internal boundary conditions for the submodel. These are "
"required to properly calculate the gradient. Note: this method modifies the "
"state of self.boundary_conditions."
msgstr ""

