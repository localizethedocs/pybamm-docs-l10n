msgid "Raises"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of pybamm.discretisations.discretisation.Discretisation.process_model:18
msgid ""
"If an empty model is passed (`model.rhs = {}` and `model.algebraic = {}` "
"and     `model.variables = {}`)"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of
#: pybamm.discretisations.discretisation.Discretisation.process_rhs_and_algebraic:1
msgid "Discretise model equations - differential ('rhs') and algebraic."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of
#: pybamm.discretisations.discretisation.Discretisation.process_rhs_and_algebraic:7
msgid ""
"Tuple of processed_rhs (dict of processed differential equations), "
"processed_concatenated_rhs, processed_algebraic (dict of processed algebraic "
"equations) and processed_concatenated_algebraic"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of pybamm.discretisations.discretisation.Discretisation.process_symbol:1
msgid ""
"Discretise operators in model equations. If a symbol has already been "
"discretised, the stored value is returned."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of pybamm.discretisations.discretisation.Discretisation.process_symbol:4
msgid "Symbol to discretise"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/pybamm/discretisations/discretisation.py:docstring
#: of pybamm.discretisations.discretisation.Discretisation.process_symbol:7
